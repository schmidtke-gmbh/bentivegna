---
// kununu-Hinweis (Karriereseite): Top-Company-Siegel, optional Note und Anzahl Bewertungen, Link zum Profil.
// Bewusst ohne Drittanbieter-Skript. Note, Anzahl und Profil-Link pflegt die Kanzlei im Redaktionssystem;
// solange der Link fehlt, erscheint kein Link. Soll später das offizielle Live-Widget von kununu kommen,
// braucht es dafür eine Einwilligung (Cookie-Banner).
import { u } from '../lib/site';
interface Props { k: { titel: string; text: string; note?: string; anzahl?: string; profil_url?: string; link_text?: string }; dunkel?: boolean }
const { k, dunkel = false } = Astro.props;
const Tag = k.profil_url ? 'a' : 'div';
---
<Tag class={`kununu${dunkel ? ' kununu--dunkel' : ''}`} href={k.profil_url || undefined} target={k.profil_url ? '_blank' : undefined} rel={k.profil_url ? 'noopener' : undefined} data-track={k.profil_url ? 'kununu_klick' : undefined}>
  <img src={u('/uploads/logos/kununu-top-company-2026.png')} alt="kununu Top Company 2026" width="34" height="45" loading="lazy">
  <span class="kununu-txt">
    <b>{k.titel}</b>
    <span>
      {k.note && <span class="kununu-note"><span class="sterne" aria-hidden="true">★★★★★</span> {k.note} von 5{k.anzahl && <> · {k.anzahl} Bewertungen</>}</span>}
      {!k.note && k.text}
    </span>
  </span>
  {k.profil_url && <span class="kununu-link">{k.link_text || 'Bewertungen ansehen'} <span class="arr"></span></span>}
</Tag>

<style is:global>
  .kununu{display:inline-flex;align-items:center;gap:12px;margin-top:26px;padding:8px 16px 8px 10px;border-radius:14px;background:#fff;border:1px solid var(--line);box-shadow:var(--shadow-s);color:var(--navy);text-align:left;text-decoration:none;transition:transform .3s var(--ease),box-shadow .3s}
  a.kununu:hover{transform:translateY(-1px);box-shadow:var(--shadow-m)}
  .kununu img{width:auto;height:44px;display:block;flex:0 0 auto}
  .kununu-txt{display:flex;flex-direction:column;line-height:1.3}
  .kununu-txt b{font-size:.92rem}
  .kununu-txt > span{font-size:.82rem;color:var(--muted)}
  .kununu-note .sterne{color:#f5b600;letter-spacing:1px}
  .kununu-link{margin-left:8px;font-size:.8rem;font-weight:700;white-space:nowrap;display:inline-flex;align-items:center;gap:6px}
  .kununu--dunkel{background:rgba(255,255,255,.06);border-color:rgba(255,255,255,.14);box-shadow:none;color:#fff}
  .kununu--dunkel .kununu-txt > span{color:rgba(255,255,255,.72)}
  .kununu--dunkel img{background:#fff;border-radius:4px;padding:2px}
  @media(max-width:560px){.kununu-link{display:none}}
</style>
