---
import Icon from './Icon.astro';
import Brand from './Brand.astro';
import { u, E, telLink, waLink } from '../lib/site';
interface Props { variante?: 'start' | 'karriere' | 'neutral' }
const { variante = 'start' } = Astro.props;
// „neutral“: Strategie-Seiten für Unternehmer aller Branchen und Privatpersonen (ohne SHK-Fokus), Kontakt wie Startseite
const claim = variante === 'karriere' || variante === 'neutral'
  ? 'Unternehmerberatung & Steuerstrategie, Überlingen am Bodensee'
  : 'Steuer- & Unternehmerberatung, spezialisiert auf SHK-Betriebe in ganz Deutschland. Digital, persönlich, per Teams.';
const wa = waLink(E.whatsapp);
// Social-Media-Profile: Reihenfolge und Links aus „Kontakt & Einstellungen“, leere Felder erscheinen nicht
const S: Record<string, string> = (E as any).social || {};
const sozial = [
  { name: 'youtube', label: 'YouTube', href: E.youtube },
  { name: 'instagram', label: 'Instagram', href: S.instagram },
  { name: 'facebook', label: 'Facebook', href: S.facebook },
  { name: 'linkedin', label: 'LinkedIn', href: S.linkedin },
  { name: 'kununu', label: 'kununu', href: S.kununu_url }
].filter((x) => x.href) as { name: 'youtube' | 'instagram' | 'facebook' | 'linkedin' | 'kununu'; label: string; href: string }[];
const cookiebot = !!(E.tracking as any).cookiebot_id;
// Kontaktblock: „Bentivegna“, darunter der Zusatz „Unternehmerberatung & Steuerstrategie“ (Wunsch Domenico, 3.11.)
const markenname = E.firma.replace(E.claim, '').trim() || 'Bentivegna';
---
<footer>
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-brand">
        <img class="foot-logo" src={u('/uploads/logos/logo-quer.svg')} alt="Bentivegna" style="filter:brightness(0) invert(1)" width="210" height="40">
        <p>{claim}</p>
        {sozial.length > 0 && (
          <ul class="foot-social" aria-label="Bentivegna in sozialen Netzwerken">
            {sozial.map((x) => <li><a href={x.href} target="_blank" rel="noopener" aria-label={`Bentivegna bei ${x.label}`} title={x.label} data-track={`social_${x.name}`}><Brand name={x.name} class="" /></a></li>)}
          </ul>
        )}
      </div>
      <div class="foot-col">
        <h4>Kanzlei</h4>
        <ul>
          <li><a href={u('/#leistungen')}>Leistungen</a></li>
          <li><a href={u('/#system')}>Unser Weg in 6 Stufen</a></li>
          <li><a href={u('/#referenzen')}>Referenzen</a></li>
          <li><a href={u('/#team')}>Über uns</a></li>
          <li><a href={u('/anfrage/')}>Analysegespräch anfragen</a></li>
          <li><a href={u('/steuerstrategie/')}>Steuerstrategie-Gespräch</a></li>
          <li><a href={u('/vermoegensstrategie/')}>Vermögensstrategie</a></li>
        </ul>
      </div>
      <div class="foot-col">
        <h4>Wissen & Service</h4>
        <ul>
          <li><a href={u('/der-chef-auf-der-baustelle/')}>Der Chef auf der Baustelle</a></li>
          <li><a href={u('/der-chef-auf-der-baustelle/selbstcheck/')}>Selbstcheck</a></li>
          <li><a href={u('/hilfe-center/')}>Hilfe-Center für Mandanten</a></li>
          <li><a href={u('/karriere/')}>Karriere</a></li>
        </ul>
      </div>
      <div class="foot-col foot-contact">
        <h4>Kontakt</h4>
        <div><Icon name="map-pin" /><span><span class="foot-name">{markenname}</span><small class="foot-claim">{E.claim}</small>{E.strasse}<br>{E.plz_ort}</span></div>
        <div><Icon name="phone" /><span><a href={telLink(E.telefon)}>{E.telefon}</a><br><small>{E.erreichbar}</small></span></div>
        <div><Icon name="mail" /><a href={`mailto:${variante === 'karriere' && E.karriere.kontakt_email ? E.karriere.kontakt_email : E.email}`}>{variante === 'karriere' && E.karriere.kontakt_email ? E.karriere.kontakt_email : E.email}</a></div>
        {wa ? <div><Brand name="whatsapp" class="wa" /><a href={wa} target="_blank" rel="noopener" data-track="whatsapp_klick">WhatsApp</a></div> : <div><Brand name="whatsapp" class="wa" /><span>WhatsApp (Nummer folgt)</span></div>}
      </div>
    </div>
    <div class="foot-bottom">
      <span class="legal"><a href={u('/impressum/')}>Impressum</a> &nbsp;·&nbsp; <a href={u('/datenschutz/')}>Datenschutz</a>{cookiebot && <> &nbsp;·&nbsp; <button type="button" class="foot-cookie" data-cookie-einstellungen>Cookie-Einstellungen</button></>}</span>
      <span class="copy">© {new Date().getFullYear()} {E.firma}</span>
      <a href="https://www.schmidtke-gmbh.de" target="_blank" rel="noopener" class="foot-credit"><span class="cl">Marketing von</span><img class="sk-logo-img" src={u('/uploads/logos/schmidtke-logo-hell.png')} alt="schmidtke." width="85" height="13" loading="lazy"></a>
    </div>
  </div>
</footer>
