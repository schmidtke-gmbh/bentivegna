---
// Artikelbild im Format 1,91:1.
// Mit hochgeladenem Motiv (ohne Text): Cover im Stil der Reihe, Badge, Titel, Unterzeile, Kapitel und Logo werden als Text darübergelegt.
// Ohne Motiv: Titelkarte im Raster der Seite.
import { u } from '../lib/site';
interface Props { bild?: string; alt?: string; teil: number; titel: string; unterzeile?: string; kapitel?: string; klein?: boolean; eager?: boolean }
const { bild, alt = '', teil, titel, unterzeile = '', kapitel = '', klein = false, eager = false } = Astro.props;
---
{bild ? (
  <div class={`art-bild art-cover${klein ? ' klein' : ''}`} role="img" aria-label={`Der Chef auf der Baustelle, Teil ${teil}: ${titel}`}>
    <img class="ac-motiv" src={u(bild)} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" width="2000" height="1267">
    <span class="ac-badge"><span class="r">Der Chef auf der Baustelle</span><span class="t">Teil {teil}</span></span>
    <span class="ac-titel">{titel}</span>
    {unterzeile && <span class="ac-unter">{unterzeile}</span>}
    {kapitel && <span class="ac-kap">{kapitel}</span>}
    <img class="ac-logo" src={u('/uploads/logos/logo-quer-mittig.svg')} alt="">
  </div>
) : (
  <div class={`art-bild art-karte${klein ? ' klein' : ''}`} role="img" aria-label={alt || `Der Chef auf der Baustelle, Teil ${teil}: ${titel}`}>
    <img class="ak-wm" src={u('/uploads/logos/schild-mono.svg')} alt="">
    <span class="chef-badge light"><span class="r">Der Chef auf der Baustelle</span><span class="t">Teil {teil}</span></span>
    <span class="ak-nr">{String(teil).padStart(2, '0')}</span>
    <span class="ak-titel">{titel}</span>
    {kapitel && <span class="ak-kap">{kapitel}</span>}
  </div>
)}
