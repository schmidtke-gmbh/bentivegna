---
// Funnel „Kostenloses Analysegespräch“: 5 Schritte, 2 Brücken, 6 Exits, dann Kontaktformular (Netlify Forms)
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Brand from '../../components/Brand.astro';
import F from '../../data/funnel.json';
import { u, E, md, waLink } from '../../lib/site';

const wa = waLink(E.whatsapp, 'Hallo Bentivegna, ich habe gerade einen Rückruf angefordert.');
const schrittNr: Record<string, number> = { s1: 1, s2: 2, s2p: 2, s3: 3, s4: 4, s5: 5 };
const extern = (z: string) => /^https?:/.test(z);
const intern = (z: string) => z.startsWith('/');
---
<Base titel={F.seo.titel} beschreibung={F.seo.beschreibung} pfad="/anfrage/" bodyClass="page-funnel" cta={{ text: 'Zur Startseite', href: u('/') }}>
  <section class="fn">
    <img class="fn-wm" src={u('/uploads/logos/schild-mono.svg')} alt="" aria-hidden="true">
    <div class="wrap fn-wrap">
      <div class="fn-kopf">
        <span class="eyebrow">{F.kopf.eyebrow}</span>
        <h1>{F.kopf.titel}</h1>
        <p>{F.kopf.text}</p>
      </div>

      <div class="fn-card" id="funnel" data-steuerstrategie={u(E.steuerstrategie_url)}>
        <div class="fn-top">
          <button type="button" class="fn-back" id="fnBack" hidden><Icon name="chevron-left" /> Zurück</button>
          <div class="fn-prog" aria-hidden="true"><span id="fnBar"></span></div>
          <span class="fn-count" id="fnCount">Schritt 1 von 5</span>
        </div>

        {Object.entries(F.schritte).map(([id, s]) => (
          <div class="fn-screen" data-s={id} data-nr={schrittNr[id]} hidden>
            <h2 class="fn-frage" tabindex="-1">{s.frage}</h2>
            <div class="fn-opts">
              {s.optionen.map((o) => (
                <button type="button" class="fn-opt" data-wert={o.id} data-text={o.text}><span>{o.text}</span><Icon name="arrow-right" /></button>
              ))}
            </div>
          </div>
        ))}

        {Object.entries(F.exits).map(([id, x]) => (
          <div class="fn-screen fn-exit" data-s={`exit-${id}`} data-exit={id} hidden>
            <span class="ico-box"><Icon name="handshake" /></span>
            <h2 class="fn-frage" tabindex="-1">{x.titel}</h2>
            <p>{x.text}</p>
            <div class="fn-btns">
              {x.buttons.map((b, i) => intern(b.ziel)
                ? <a class={`btn ${i === 0 ? 'btn--gold' : 'btn--ghost'}`} href={u(b.ziel)} data-track={`funnel_exit_${id}_link`}>{b.text} <span class="arr"></span></a>
                : extern(b.ziel)
                ? <a class={`btn ${i === 0 ? 'btn--gold' : 'btn--ghost'}`} href={b.ziel} target="_blank" rel="noopener" data-track={`funnel_exit_${id}_link`}>{b.text} <span class="arr"></span></a>
                : <button type="button" class={`btn ${i === 0 ? 'btn--gold' : 'btn--ghost'}`} data-geh={b.ziel.replace('bruecke:', 'bruecke-')}>{b.text} <span class="arr"></span></button>)}
            </div>
          </div>
        ))}

        <div class="fn-screen fn-exit" data-s="bruecke-steuerstrategie" hidden>
          <span class="ico-box"><Icon name="landmark" /></span>
          <h2 class="fn-frage" tabindex="-1">{F.bruecken.steuerstrategie.titel}</h2>
          <p>{F.bruecken.steuerstrategie.text}</p>
          <div class="fn-btns"><a class="btn btn--gold" href={u(E.steuerstrategie_url)} id="fnStrategie" data-track="funnel_weiter_steuerstrategie">{F.bruecken.steuerstrategie.button} <span class="arr"></span></a></div>
        </div>
        <div class="fn-screen fn-exit" data-s="bruecke-nachfolge" hidden>
          {F.bruecken.nachfolge.siegel
            ? <img class="fn-siegel" src={u(F.bruecken.nachfolge.siegel)} alt="Fachberater für Unternehmensnachfolge (DStV e. V.)" width="900" height="316">
            : <span class="ico-box"><Icon name="award" /></span>}
          <h2 class="fn-frage" tabindex="-1">{F.bruecken.nachfolge.titel}</h2>
          <p>{F.bruecken.nachfolge.text}</p>
          {/* Nachfolge wird nicht angefragt, sondern gebucht: Unternehmer über das Steuerstrategie-Gespräch, Privatpersonen über die Vermögensstrategie (Domenico, 2.11.) */}
          <p data-nf="unternehmer">{F.bruecken.nachfolge.text_unternehmer}</p>
          <p data-nf="privat" hidden>{F.bruecken.nachfolge.text_privat}</p>
          <div class="fn-btns">
            <a class="btn btn--gold" data-nf="unternehmer" href={u(E.steuerstrategie_url)} data-track="funnel_weiter_steuerstrategie_nachfolge">{F.bruecken.nachfolge.button_unternehmer} <span class="arr"></span></a>
            <a class="btn btn--gold" data-nf="privat" hidden href={u(E.vermoegensstrategie_url)} data-track="funnel_weiter_vermoegensstrategie_nachfolge">{F.bruecken.nachfolge.button_privat} <span class="arr"></span></a>
          </div>
        </div>

        <div class="fn-screen" data-s="form">
          <h2 class="fn-frage" tabindex="-1">{F.formular.titel}</h2>
          <form name="anfrage" method="POST" data-netlify="true" netlify-honeypot="bot-feld" action={u('/anfrage/danke/')} id="fnForm" class="fn-form">
            <input type="hidden" name="form-name" value="anfrage">
            <p class="hp-feld"><label>Nicht ausfüllen: <input name="bot-feld" tabindex="-1" autocomplete="off"></label></p>
            <input type="hidden" name="lane" value="">
            <input type="hidden" name="wer" value="">
            <input type="hidden" name="anliegen" value="">
            <input type="hidden" name="umsatz" value="">
            <input type="hidden" name="phase" value="">
            <input type="hidden" name="arbeitsweise" value="">
            <div class="fn-row">
              <div class="fld"><label for="fn-vn">Vorname</label><input id="fn-vn" name="vorname" required autocomplete="given-name"></div>
              <div class="fld"><label for="fn-nn">Nachname</label><input id="fn-nn" name="nachname" required autocomplete="family-name"></div>
            </div>
            <div class="fld" id="fnFirma"><label for="fn-firma">Firma</label><input id="fn-firma" name="firma" required autocomplete="organization"></div>
            <div class="fn-row">
              <div class="fld"><label for="fn-tel">Telefonnummer</label><input id="fn-tel" name="telefon" type="tel" required autocomplete="tel"></div>
              <div class="fld"><label for="fn-mail">E-Mail</label><input id="fn-mail" name="email" type="email" required autocomplete="email"></div>
            </div>
            <fieldset class="fld fn-radio">
              <legend>Rückruf am liebsten</legend>
              <label><input type="radio" name="rueckruf" value="vormittags" required> vormittags</label>
              <label><input type="radio" name="rueckruf" value="nachmittags"> nachmittags</label>
              <label><input type="radio" name="rueckruf" value="egal"> egal</label>
            </fieldset>
            <div class="fld" id="fnMa"><label for="fn-ma">Mitarbeiterzahl <small>(optional)</small></label>
              <select id="fn-ma" name="mitarbeiter"><option value="">Bitte wählen</option><option>1 bis 5</option><option>6 bis 10</option><option>11 bis 20</option><option>21 bis 50</option><option>mehr als 50</option></select>
            </div>
            <label class="chk"><input type="checkbox" name="einwilligung" required> <span set:html={md(F.formular.einwilligung).replace('href="/', `href="${u('/')}`)} /></label>
            <button class="btn btn--gold" type="submit">{F.formular.button} <span class="arr"></span></button>
            <p class="fn-err" role="alert" hidden>Das hat leider nicht geklappt. Bitte versuch es noch einmal oder ruf uns an: {E.telefon}.</p>
          </form>
        </div>

        <div class="fn-screen fn-exit" data-s="danke" hidden>
          <span class="ico-box" style="background:var(--navy);color:#fff"><Icon name="check" /></span>
          <h2 class="fn-frage" tabindex="-1">{F.danke.titel}</h2>
          <p id="fnDankeText">{F.danke.text}</p>
          <p>{F.danke.whatsapp}</p>
          <div class="fn-btns">
            {wa ? <a class="btn btn--gold" href={wa} target="_blank" rel="noopener" data-track="whatsapp_klick"><Brand name="whatsapp" /> WhatsApp <span class="arr"></span></a>
                : <a class="btn btn--gold" href="#whatsapp" aria-disabled="true" title="WhatsApp-Nummer wird noch ergänzt"><Brand name="whatsapp" /> WhatsApp <span class="arr"></span></a>}
            <a class="btn btn--ghost" href={u('/')}>Zur Startseite <span class="arr"></span></a>
          </div>
        </div>
      </div>
      <p class="fn-foot"><Icon name="shield-check" /> Deine Angaben gehen nur an unser Sekretariat. Keine Weitergabe, kein Newsletter.</p>
    </div>
  </section>
</Base>

<style is:global>
  .fn{position:relative;padding:150px 0 90px;min-height:100vh;background:radial-gradient(1000px 600px at 85% 0,var(--cool),rgba(232,234,239,0) 60%),linear-gradient(180deg,#fff,var(--cream));overflow:hidden}
  .fn-wm{position:absolute;right:-80px;top:80px;width:440px;opacity:.28;transform:rotate(12deg);pointer-events:none}
  .fn-wrap{max-width:780px;position:relative;z-index:1}
  .fn-kopf h1{font-size:clamp(2rem,4.4vw,3.1rem);margin-top:16px}
  .fn-kopf p{color:var(--muted);font-size:1.08rem;margin-top:14px;max-width:620px}
  .fn-card{margin-top:34px;background:#fff;border:1px solid var(--line);border-radius:16px;box-shadow:var(--shadow-m);padding:28px 32px 34px}
  .fn-top{display:flex;align-items:center;gap:16px;margin-bottom:26px}
  .fn-back{display:inline-flex;align-items:center;gap:4px;background:none;border:0;font:inherit;font-weight:700;color:var(--navy);cursor:pointer;padding:6px 0}
  .fn-back .ico{width:16px;height:16px}
  .fn-prog{flex:1;height:6px;border-radius:6px;background:var(--cream);overflow:hidden}
  .fn-prog span{display:block;height:100%;width:20%;background:linear-gradient(90deg,var(--brown),var(--navy));border-radius:6px;transition:width .45s var(--ease)}
  .fn-count{font-size:.82rem;font-weight:700;color:var(--muted);white-space:nowrap}
  .fn-frage{font-size:clamp(1.35rem,2.6vw,1.8rem);line-height:1.2;outline:none}
  .fn-opts{display:grid;gap:12px;margin-top:22px}
  .fn-opt{display:flex;align-items:center;justify-content:space-between;gap:16px;width:100%;text-align:left;background:#fff;border:1.5px solid var(--line);border-radius:12px;padding:18px 20px;font:inherit;font-size:1.04rem;font-weight:600;color:var(--navy);cursor:pointer;min-height:64px;transition:border-color .2s,background .2s,transform .2s var(--ease)}
  .fn-opt:hover,.fn-opt:focus-visible{border-color:var(--navy);background:var(--cool);transform:translateX(3px);outline:none}
  .fn-opt .ico{width:20px;height:20px;color:var(--brown);flex:0 0 auto}
  .fn-exit p{color:var(--muted);font-size:1.06rem;margin-top:14px;line-height:1.6}
  .fn-exit .ico-box{margin-bottom:16px}
  .fn-btns{display:flex;flex-wrap:wrap;gap:12px;margin-top:26px}
  .fn-form{display:grid;gap:14px;margin-top:22px}
  .fn-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
  /* Rückruf-Auswahl als drei Felder nebeneinander. Die allgemeine Feldregel (.fld input: volle Breite, Innenabstand)
     darf hier nicht greifen, sonst rutscht der Punkt in die Mitte und der Text an den Rand (Domenico, 3.11.). */
  .fn-form .fn-radio{display:flex;flex-wrap:wrap;gap:10px;border:0;padding:0;margin:0;min-width:0}
  .fn-form .fn-radio legend{float:left;width:100%;padding:0;font-size:.85rem;font-weight:700;color:var(--navy);margin-bottom:8px}
  .fn-form .fn-radio label{flex:1 1 0;min-width:120px;display:flex;align-items:center;gap:10px;margin:0;padding:12px 14px;border:1.5px solid var(--line);border-radius:10px;background:#fff;font-size:1rem;font-weight:600;color:var(--navy);cursor:pointer;transition:border-color .2s,background .2s}
  .fn-form .fn-radio label:hover{border-color:var(--navy)}
  .fn-form .fn-radio label:has(input:checked){border-color:var(--navy);background:var(--cool)}
  .fn-form .fn-radio input[type=radio]{flex:0 0 auto;width:18px;height:18px;margin:0;padding:0;border:0;accent-color:var(--navy)}
  .fn-form .fn-radio input[type=radio]:focus{outline:none}
  .fn-form .fn-radio input[type=radio]:focus-visible{outline:2px solid var(--blue);outline-offset:2px}
  @media(max-width:480px){.fn-form .fn-radio label{flex-basis:100%}}
  .fn-form .btn{justify-self:start;margin-top:4px}
  .fn-err{color:#b4583f;font-weight:600;font-size:.92rem}
  .fn-foot{display:flex;align-items:center;gap:8px;justify-content:center;margin-top:20px;color:var(--muted);font-size:.88rem}
  .fn-foot .ico{width:16px;height:16px;color:var(--brown)}
  .fld{display:grid;gap:6px}
  .fld label{font-size:.85rem;font-weight:700;color:var(--navy)}
  .fld label small{font-weight:500;color:var(--muted)}
  .fld input,.fld select{width:100%;border:1px solid #d6d3ca;border-radius:8px;padding:13px 14px;font:inherit;font-size:1rem;color:var(--ink);background:#fff}
  .fld input:focus,.fld select:focus{outline:2px solid var(--blue);outline-offset:1px;border-color:var(--blue)}
  .chk{display:flex;gap:10px;align-items:flex-start;font-size:.86rem;color:var(--muted)}
  .chk input{margin-top:3px;width:18px;height:18px;flex:0 0 auto;accent-color:var(--navy)}
  .chk a{color:var(--navy);text-decoration:underline}
  .hp-feld{position:absolute!important;left:-9999px!important;width:1px;height:1px;overflow:hidden}
  .fn-screen[hidden]{display:none!important}
  .page-funnel .fab{display:none}
  @media(max-width:640px){.fn{padding:118px 0 60px}.fn-card{padding:20px 18px 26px;border-radius:14px}.fn-row{grid-template-columns:1fr}.fn-opt{padding:16px}.fn-wm{width:260px;right:-90px}}
</style>

<script>
  type Antwort = { wert: string; text: string };
  const root = document.getElementById('funnel')!;
  const screens = [...root.querySelectorAll<HTMLElement>('.fn-screen')];
  const bar = document.getElementById('fnBar')!, count = document.getElementById('fnCount')!, back = document.getElementById('fnBack') as HTMLButtonElement;
  const form = document.getElementById('fnForm') as HTMLFormElement;
  const a: Record<string, Antwort> = {};
  const verlauf: string[] = [];
  let aktuell = 's1';
  let lane = '';
  const track = (ev: string, data: Record<string, unknown> = {}) => window.bvTrack?.(ev, data);

  function zeige(id: string, merken = true) {
    if (merken && aktuell !== id) verlauf.push(aktuell);
    aktuell = id;
    screens.forEach((s) => (s.hidden = s.dataset.s !== id));
    const scr = screens.find((s) => s.dataset.s === id)!;
    const nr = Number(scr.dataset.nr || 0);
    const fertig = id === 'danke';
    bar.style.width = (fertig || id.startsWith('form') ? 100 : nr ? nr * 20 : 100) + '%';
    count.textContent = nr ? `Schritt ${nr} von 5` : id.startsWith('form') ? 'Letzter Schritt' : fertig ? 'Erledigt' : '';
    back.hidden = verlauf.length === 0 || fertig;
    (scr.querySelector('.fn-frage') as HTMLElement | null)?.focus({ preventScroll: true });
    const top = root.getBoundingClientRect().top + window.scrollY - 110;
    if (window.scrollY > top) window.scrollTo({ top, behavior: 'smooth' });
    if (id.startsWith('exit-')) track('funnel_exit_' + id.slice(5));
    else if (id.startsWith('bruecke-')) track('funnel_' + id.replace('-', '_'));
    else if (nr) track('funnel_schritt', { schritt: id });
  }

  function formular() {
    const privat = a.s1?.wert === 'privat';
    const firma = document.getElementById('fnFirma')!, fi = firma.querySelector('input')!;
    firma.hidden = privat; fi.required = !privat; if (privat) fi.value = '';
    (document.getElementById('fnMa') as HTMLElement).hidden = privat;
    const set = (n: string, v = '') => ((form.elements.namedItem(n) as HTMLInputElement).value = v);
    set('lane', lane);
    set('wer', a.s1?.text);
    set('anliegen', (a.s2 || a.s2p)?.text);
    set('umsatz', a.s3?.text);
    set('phase', a.s4?.text);
    set('arbeitsweise', a.s5?.text);
    zeige('form');
  }

  // Nachfolge-Brücke: Unternehmer → Steuerstrategie-Gespräch, Privatpersonen → Vermögensstrategie
  function nachfolge() {
    const privat = a.s1?.wert === 'privat';
    root.querySelectorAll<HTMLElement>('[data-s="bruecke-nachfolge"] [data-nf]').forEach((el) => {
      el.hidden = el.dataset.nf !== (privat ? 'privat' : 'unternehmer');
    });
    zeige('bruecke-nachfolge');
  }

  function weiter(schritt: string, wert: string) {
    const shk = a.s1?.wert === 'shk';
    const anliegen = a.s2?.wert;
    switch (schritt) {
      case 's1':
        if (wert === 'gruender') return zeige('exit-A');
        if (wert === 'privat') return zeige('s2p');
        return zeige('s2');
      case 's2':
        if (wert === 'guenstig') return zeige('exit-C');
        // Nachfolge wird immer gebucht, nicht angefragt, auch bei SHK-Betrieben
        if (wert === 'nachfolge') return nachfolge();
        if (shk) { lane = wert === 'betreuung' ? 'Betreuung' : 'Gestaltung'; return zeige('s3'); }
        if (wert === 'betreuung') return zeige('exit-B');
        return zeige('bruecke-steuerstrategie');
      case 's2p':
        if (wert === 'nachfolge') return nachfolge();
        if (wert === 'vermoegen') return zeige('exit-D');
        return zeige('exit-C');
      case 's3':
        if (wert === 'unter750') {
          if (anliegen === 'betreuung') return zeige('exit-E');
          return zeige('bruecke-steuerstrategie');
        }
        lane = anliegen === 'betreuung' ? 'Betreuung' : 'Gestaltung';
        if (wert === '750bis1') lane = 'Grenzfall';
        return zeige('s4');
      case 's4':
        return zeige('s5');
      case 's5':
        if (wert === 'nein') return zeige('exit-F');
        return formular();
    }
  }

  root.addEventListener('click', (e) => {
    const opt = (e.target as HTMLElement).closest<HTMLButtonElement>('.fn-opt');
    if (opt) {
      const schritt = opt.closest<HTMLElement>('.fn-screen')!.dataset.s!;
      a[schritt] = { wert: opt.dataset.wert!, text: opt.dataset.text! };
      if (schritt === 's1') { delete a.s2; delete a.s2p; delete a.s3; delete a.s4; delete a.s5; lane = ''; }
      weiter(schritt, opt.dataset.wert!);
      return;
    }
    const geh = (e.target as HTMLElement).closest<HTMLElement>('[data-geh]');
    if (geh) {
      const ziel = geh.dataset.geh!;
      zeige(ziel);
    }
  });
  back.addEventListener('click', () => { const z = verlauf.pop(); if (z) zeige(z, false); });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
    btn.disabled = true;
    try {
      const body = new URLSearchParams(new FormData(form) as unknown as Record<string, string>).toString();
      const res = await fetch(form.getAttribute('action') || '/', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body });
      if (!res.ok) throw new Error(String(res.status));
      track('funnel_formular_abgeschickt', { lane: lane || 'Betreuung' });
      verlauf.length = 0;
      zeige('danke', false);
    } catch (err) {
      btn.disabled = false;
      (form.querySelector('.fn-err') as HTMLElement).hidden = false;
    }
  });

  // Start: Formular nur über die Schritte erreichbar
  track('funnel_start');
  zeige('s1', false);
</script>
