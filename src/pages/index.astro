    <div class="ref-grid">
      {S.referenzen.eintraege.map((r, i) => (
        <article class={`ref-card reveal d${i}`}>
          <button type="button" class="ref-video" data-video={r.youtube_id || undefined} aria-label={`Video mit ${r.name} ansehen${r.dauer ? ', ' + r.dauer + ' Minuten' : ''}`}>
            {r.bild
              ? <img src={u(r.bild)} alt="" width="800" height="450" loading="lazy">
              : <span class="ref-poster"><img class="cs-schild" src={u('/uploads/logos/schild-mono.svg')} alt=""><span class="cs-ini">{initialen(r.name)}</span></span>}
            <span class="ref-tag">{r.kategorie}</span>
            {r.youtube_id && <span class="ref-play" aria-hidden="true"><svg viewBox="0 0 22 26"><path d="M21 11.27a2 2 0 0 1 0 3.46L3 24.66A2 2 0 0 1 0 22.93V3.07A2 2 0 0 1 3 1.34L21 11.27Z"/></svg></span>}
