<!-- ============ ENTWICKLUNG: Umsatz + Gewinn ============ -->
<section class="section umsatz">
  <div class="wrap">
    <div class="section-head reveal" style="max-width:760px">
      <span class="eyebrow">{ent.eyebrow}</span>
      <h2 style="margin-top:18px">{ent.titel}</h2>
      <p>{ent.intro}</p>
    </div>
    <div class="uz-stapel" data-stapel>
      <article class="uz-karte" style="--i:0">
        <div class="uz-karte-innen">
          <div class="uz-text">
            <span class="uz-eyebrow"><Icon name="calculator" /> {ent.karte1_eyebrow}</span>
            <h3>{ent.karte1_titel}</h3>
            <p>{ent.karte1_text}</p>
            <div class="uz-chiprow">{ent.karte1_chips.map((c, i) => <span class="uz-pill"><em>{i === 0 ? '+' : '✓'}</em> {c}</span>)}</div>
          </div>
          <figure class="uz-film"><video src={u('/uploads/entwicklung/nachkalkulation.mp4')} poster={u('/uploads/entwicklung/nachkalkulation-ende.webp')} data-startbild={u('/uploads/entwicklung/nachkalkulation-start.webp')} muted loop playsinline preload="none" aria-label="Animierte Beispielrechnung: Deckungsbeitrag einer Baustelle und was 2 Prozentpunkte mehr Marge im Jahr bringen" data-film></video><img class="uz-film-druck" src={u('/uploads/entwicklung/nachkalkulation-ende.webp')} alt="" aria-hidden="true" loading="lazy"></figure>
        </div>
      </article>
      <article class="uz-karte uz-karte--gedreht" style="--i:1">
        <div class="uz-karte-innen">
          <figure class="uz-film"><video src={u('/uploads/entwicklung/liquiditaet.mp4')} poster={u('/uploads/entwicklung/liquiditaet-ende.webp')} data-startbild={u('/uploads/entwicklung/liquiditaet-start.webp')} muted loop playsinline preload="none" aria-label="Animierter Beispielverlauf: Kontostand über 13 Wochen ohne und mit Abschlagsplan" data-film></video><img class="uz-film-druck" src={u('/uploads/entwicklung/liquiditaet-ende.webp')} alt="" aria-hidden="true" loading="lazy"></figure>
          <div class="uz-text">
            <span class="uz-eyebrow"><Icon name="wallet" /> {ent.karte2_eyebrow}</span>
            <h3>{ent.karte2_titel}</h3>
            <p>{ent.karte2_text}</p>
            <div class="uz-chiprow">{ent.karte2_chips.map((c, i) => <span class="uz-pill"><em>{i === 0 ? '↑' : '✓'}</em> {c}</span>)}</div>
          </div>
        </div>
      </article>
    </div>
    <div class="uz-grid uz-grid--zahlen reveal d1">
      <div class="uz-stat">
        <div class="uz-kpi"><span class="uz-big" data-to={ent.kpi_umsatz} data-fmt="plus">+{ent.kpi_umsatz} %</span><div class="cap"><b>{ent.kpi_umsatz_text}</b></div></div>
        <div class="uz-kpi"><span class="uz-big gold" data-from={ent.kpi_marge_von} data-to={ent.kpi_marge_auf} data-fmt="marge">{ent.kpi_marge_von} → {ent.kpi_marge_auf} %</span><div class="cap"><b>{ent.kpi_marge_text}</b></div></div>
        <div class="cap">{ent.kpi_unter}</div>
      </div>
      <div class="uz-feed">
        <div class="uz-feed-top">
          <h3>Umsatz und Gewinn</h3>
          <p>Monat für Monat, vom Start bis heute.</p>
          <div class="uz-legend"><span><i style="background:#998a6d"></i>Umsatz</span><span><i style="background:#273365"></i>Gewinn</span></div>
        </div>
        <div class="uz-chart" id="uzChart" data-reihe={JSON.stringify(reihe)}>
          <svg viewBox={`0 0 ${CW} ${CH}`} preserveAspectRatio="none" aria-hidden="true"><defs>
            <linearGradient id="uzg" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="rgba(153,138,109,.30)"/><stop offset="1" stop-color="rgba(153,138,109,0)"/></linearGradient>
            <linearGradient id="uzn" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="rgba(39,51,101,.16)"/><stop offset="1" stop-color="rgba(39,51,101,0)"/></linearGradient></defs>
            <path d={chartFlaecheU} fill="url(#uzg)"/><path d={chartFlaecheG} fill="url(#uzn)"/>
            <path class="uz-line" d={chartLinieU} fill="none" stroke="#998a6d" stroke-width="2.5" vector-effect="non-scaling-stroke" stroke-linecap="round" stroke-linejoin="round"/>
            <path class="uz-line" d={chartLinieG} fill="none" stroke="#273365" stroke-width="2.5" vector-effect="non-scaling-stroke" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <div class="uz-months">{reihe.map((d) => <span>{d.m}</span>)}</div>
          <div class="uz-chip start"><span class="l">Start</span><span class="v">{mio(reihe[0].u)}<small>Gewinn {reihe[0].g} T€</small></span></div>
          <div class="uz-chip end"><span class="l">Heute</span><span class="v">{mio(reihe[11].u)}<small>Gewinn {reihe[11].g} T€</small></span></div>
        </div>
      </div>
      <div class="uz-note">{ent.hinweis}</div>
    </div>
  </div>
</section>

