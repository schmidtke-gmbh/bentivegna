          {S.stufen.schritte.map((s, i) => (
            <div class={`method-slide${i === 0 ? ' active' : ''}`} data-index={i}><img src={u(s.bild)} alt={s.titel} loading="lazy"><div class="method-cap"><span class="s">{String(i + 1).padStart(2, '0')}</span><span><b>{s.titel}</b><em>{s.bild_unter}</em></span></div></div>
