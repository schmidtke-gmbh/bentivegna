---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Brand from '../components/Brand.astro';
import Kununu from '../components/Kununu.astro';
import K from '../data/karriere.json';
import S from '../data/startseite.json';
import { u, E, md, waLink, istVeroeffentlicht } from '../lib/site';
import { getCollection } from 'astro:content';

const anfrage = u('/anfrage/');
const wa = waLink(E.whatsapp, 'Hallo Bentivegna, ich habe eine kurze Frage:');
const B = E.bewertungen;
const L = S.leistungen;

// Neueste Teile der Buchreihe für den Wissens-Teaser
const artikel = (await getCollection('artikel'))
  .filter((a) => istVeroeffentlicht(a.data))
  .sort((a, b) => b.data.teil - a.data.teil)
  .slice(0, 3);

// Entwicklung: Monatswerte Umsatz (T€) und Gewinnmarge (%) als Beispielwerte
const monate = ['Jan', 'Feb', 'Mär', 'Apr', 'Mai', 'Jun', 'Jul', 'Aug', 'Sep', 'Okt', 'Nov', 'Dez'];
const verlauf = [0, 0.066, 0.145, 0.263, 0.368, 0.474, 0.579, 0.671, 0.789, 0.882, 0.947, 1];
const ent = S.entwicklung;
// Hero: zweite Zeile an den Punkten in feste Zeilen teilen ("RENTABEL." kommt mit in die erste Zeile)
const heroTeile = S.hero.zeile2.split(/(?<=\.)\s+/).filter(Boolean);
const reihe = monate.map((m, i) => {
  const umsatz = Math.round(ent.umsatz_start + (ent.umsatz_ende - ent.umsatz_start) * verlauf[i]);
  const marge = ent.kpi_marge_von + (ent.kpi_marge_auf - ent.kpi_marge_von) * Math.pow(i / 11, 0.85);
  return { m, u: umsatz, g: Math.round((umsatz * marge) / 100) };
});
// Umsatz/Gewinn-Chart schon beim Bauen als SVG, damit er ohne JavaScript und im Druck sichtbar ist (Rechnung wie in startseite.ts)
const CW = 1000, CH = 300, cPadT = 24, cPlotH = CH - cPadT - 58;
const cuMin = Math.min(...reihe.map((d) => d.u)) - 150, cuMax = Math.max(...reihe.map((d) => d.u)) + 50, cgMax = Math.max(...reihe.map((d) => d.g)) * 2.4;
const cX = (i: number) => (i / (reihe.length - 1)) * CW;
const cYU = (v: number) => cPadT + (1 - (v - cuMin) / (cuMax - cuMin)) * cPlotH;
const cYG = (v: number) => cPadT + (1 - v / cgMax) * cPlotH;
const cPfad = (f: (i: number) => number) => reihe.map((_, i) => (i ? 'L' : 'M') + cX(i).toFixed(1) + ',' + f(i).toFixed(1)).join(' ');
const chartLinieU = cPfad((i) => cYU(reihe[i].u)), chartLinieG = cPfad((i) => cYG(reihe[i].g));
const chartFlaecheU = 'M0,' + CH + ' ' + chartLinieU.replace(/^M/, 'L') + ' L' + CW + ',' + CH + ' Z';
const chartFlaecheG = 'M0,' + CH + ' ' + chartLinieG.replace(/^M/, 'L') + ' L' + CW + ',' + CH + ' Z';
const mio = (t: number) => (t / 1000).toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' Mio €';

const initialen = (n: string) => n.split(' ').map((w) => w[0]).slice(0, 2).join('');

const faqLd = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: S.faq.fragen.map((f) => ({ '@type': 'Question', name: f.frage, acceptedAnswer: { '@type': 'Answer', text: f.antwort } }))
};

const UEB = [35.92, 93.58];
const swListe = S.software.liste.filter((m) => m.anzeigen !== false);
const markenListe = S.marken.liste.filter((m) => m.anzeigen !== false);
const geoPins = [[46.39,9.43],[44.98,19.34],[67.92,12.39],[32,25.4],[42.13,34.43],[82.15,32.58],[17.44,45.5],[9.9,49.17],[11.93,52.9],[70.91,47.74],[85.77,51.45],[56.27,52.29],[30.69,63.51],[56.78,71.97],[36.15,80.66],[62.29,88.88],[21.54,90.63]];
---
<Base titel={S.seo.titel} beschreibung={S.seo.beschreibung} pfad="/" jsonld={[faqLd]}>

<!-- ============ HERO ============ -->
<section class="hero hero--b" id="top">
  <canvas id="heroCanvas" aria-hidden="true"></canvas>
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <div class="hero-in h1 hero-marker-zeile"><span class={`hero-marker${S.hero.marker_tag ? '' : ' ohne-tag'}`}>{S.hero.marker_tag && <span class="tag">{S.hero.marker_tag}</span>}<span>{S.hero.marker_text}</span></span></div>
      <h1>
        <em class="hero-in h2">{S.hero.kicker}</em>
        <span class="hz hero-in h2">{S.hero.zeile1 + ' '}<span class="ln2">{heroTeile[0]}</span></span>
        {heroTeile.slice(1).map((t) => <span class="hz ln2 hero-in h3">{t}</span>)}
      </h1>
      <p class="hero-sub hero-in h4">{S.hero.subline}</p>
      <div class="hero-cta hero-in h5">
        <a href={anfrage} class="btn btn--gold" data-track="cta_hero">{S.hero.button_primaer} <span class="arr"></span></a>
        <a href="#leistungen" class="btn btn--ghost">{S.hero.button_sekundaer} <span class="arr"></span></a>
      </div>
      <!-- Nutzenzeile: das Satzende läuft einmal durch die Punkte und bleibt auf dem letzten stehen -->
      <p class="hero-wechsel hero-in h5" data-wechsel>
        <span class="hw-ein">{S.hero.nutzen_einleitung}</span>
        <span class="hw-slot" aria-hidden="true"><span class="hw-fenster"><span class="hw-lauf">{(S.hero.bullets.length > 1 ? [...S.hero.bullets, S.hero.bullets[0]] : S.hero.bullets).map((b, i) => <span class={i === S.hero.bullets.length ? 'hw-klon' : undefined}>{b.replace(/\.$/, '')}.</span>)}</span></span><span class="hw-strich"></span></span>
        <span class="sr-only">{S.hero.bullets.join(', ')}.</span>
      </p>
      {(B.trustpilot_aktiv || B.google_aktiv) && (
        <div class="hero-trust-row hero-in h5">
          {B.trustpilot_aktiv && (
            <a class="hero-trust rating" href={B.trustpilot_url || undefined} target="_blank" rel="noopener">
              <div class="tp-top"><div class="tp-stars"><i>★</i><i>★</i><i>★</i><i>★</i><i>★</i></div><span class="tp-logo"><span class="s">★</span>Trustpilot</span></div>
              <div class="tp-meta"><b>{B.trustpilot_wert} von 5</b> · {B.trustpilot_anzahl} Bewertungen</div>
            </a>
          )}
          {B.google_aktiv && (
            <a class="rating" href={B.google_url || undefined} target="_blank" rel="noopener">
              <span class="g-logo">Google <span class="g-stars">★★★★★</span></span>
              <span class="tp-meta"><b>{B.google_wert} von 5</b> · {B.google_anzahl} Bewertungen</span>
            </a>
          )}
        </div>
      )}
    </div>
    <div class="hero-rechts">
      <div class="hero-media hero-media--gruppe hero-in hm">
        <div class="hg-buehne">
          <img class="hero-schild" src={u('/uploads/logos/schild-mono.svg')} alt="" aria-hidden="true">
          <img class="hero-gruppe" id="heroImg" src={u(S.hero.bild)} srcset={S.hero.bild_klein ? `${u(S.hero.bild_klein)} 820w, ${u(S.hero.bild)} 1400w` : undefined} sizes="(max-width: 1024px) 92vw, 600px" alt={S.hero.bild_alt} width="1400" height="1039" fetchpriority="high">
        </div>
        <span class="hero-focus">{S.hero.fokus_label}</span>
        {S.hero.video_youtube_id && (
          <button class="hero-play-pille" type="button" data-video={S.hero.video_youtube_id} data-hochkant={S.hero.video_hochkant ? '1' : undefined} data-track="hero_video" aria-label={S.hero.video_unterzeile ? `${S.hero.video_label || 'Video abspielen'}: ${S.hero.video_unterzeile}` : undefined}>
            <span class="hp-knopf" aria-hidden="true"><span class="hp-wellen"><i></i><i></i><i></i></span><svg viewBox="0 0 22 26"><path d="M21 11.27a2 2 0 0 1 0 3.46L3 24.66A2 2 0 0 1 0 22.93V3.07A2 2 0 0 1 3 1.34L21 11.27Z"/></svg></span>
            <b>{S.hero.video_label || 'Video abspielen'}</b>
          </button>
        )}
      </div>
      <div class="hero-awards hero-awards--karte hero-in h5">
        <span class="ha-label">{S.auszeichnungen.titel}</span>
        <div class="ha-logos">
          {S.auszeichnungen.logos.map((l) => <img src={u(l.bild)} alt={l.alt} height="72">)}
          {S.auszeichnungen.textsiegel_bild
            ? <img class="ha-fb" src={u(S.auszeichnungen.textsiegel_bild)} alt={`${S.auszeichnungen.textsiegel_titel} (${S.auszeichnungen.textsiegel_unter})`} height="72">
            : <span class="seal-text ha-seal"><span class="ico-box"><Icon name="award" /></span><span><b>{S.auszeichnungen.textsiegel_titel}</b><small>{S.auszeichnungen.textsiegel_unter}</small></span></span>}
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============ KENNZAHLEN ============ -->
<section class="stats" aria-label="Kennzahlen">
  <div class="wrap">
    {S.kennzahlen.map((k, i) => (
      <div class={`stat reveal d${i}`}>
        <span class="num" data-count={k.zahl} data-prefix={k.praefix} data-suffix={k.suffix} data-alt-num={k.alt_zahl}>{k.praefix}{k.zahl}{k.suffix}</span>
        <span class="lbl" data-alt-lbl={k.alt_label}>{k.label}</span>
      </div>
    ))}
  </div>
</section>

<!-- ============ PROBLEM ============ -->
<section class="section pain" id="problem">
  <div class="wrap">
    <div class="section-head pain-head reveal">
      <span class="eyebrow">{S.problem.eyebrow}</span>
      <h2 style="margin-top:18px">{S.problem.titel} <span class="serif-accent">{S.problem.akzent}</span></h2>
      <p>{S.problem.intro}</p>
    </div>
    <div class="pain-grid five">
      {S.problem.karten.map((k, i) => (
        <div class={`pain-card reveal d${(i % 3) + 1}${i === 4 ? ' accent' : ''}`}>
          <div class="ic"><Icon name={k.icon} /></div>
          <h3>{k.titel}</h3>
          <p>{k.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="pullquote">
  <div class="wrap">
    <span class="pq-mark reveal" aria-hidden="true">&#8220;</span>
    <blockquote class="pq-text reveal d1">{S.zitat.zeile1}<br><span class="pq-em">{S.zitat.zeile2}</span></blockquote>
    <p class="pq-sub reveal d2">{S.zitat.unter}</p>
  </div>
</section>

<!-- ============ VORHER / NACHHER ============ -->
<section class="section compare">
  <div class="wrap">
    <div class="section-head reveal" style="max-width:720px">
      <span class="eyebrow">{S.unterschied.eyebrow}</span>
      <h2 style="margin-top:18px">{S.unterschied.titel} <span class="serif-accent">{S.unterschied.akzent}</span></h2>
    </div>
    <div class="compare-grid">
      <div class="compare-col bad reveal d1">
        <span class="pill">{S.unterschied.links_pill}</span>
        <h3>{S.unterschied.links_titel}</h3>
        <ul>{S.unterschied.links.map((t) => <li><span class="mark x"><Icon name="x" /></span> {t}</li>)}</ul>
      </div>
      <div class="compare-col good reveal d2">
        <span class="pill">{S.unterschied.rechts_pill}</span>
        <h3>{S.unterschied.rechts_titel}</h3>
        <ul>{S.unterschied.rechts.map((t) => <li><span class="mark c"><Icon name="check" /></span> {t}</li>)}</ul>
      </div>
    </div>
  </div>
</section>

<div class="marquee marquee--ruhig">
  <div class="marquee-track">
    {S.laufband.map((t) => <span>{t}</span>)}
  </div>
</div>

<!-- ============ LEISTUNGEN ============ -->
<section class="section leist" id="leistungen">
  <div class="wrap">
    <div class="section-head reveal" style="text-align:center;max-width:660px;margin:0 auto 48px">
      <span class="eyebrow" style="justify-content:center">{L.eyebrow}</span>
      <h2 style="margin-top:18px">{L.titel}</h2>
      <p set:html={L.intro.replace('Unser Kerngeschäft', 'Unser&nbsp;Kerngeschäft')} />
    </div>
    <div class="feat-grid">
      <!-- 1: Unternehmensberatung (breit) -->
      <div class="feat-card feat-wide">
        <div class="feat-top">
          <div class="feat-ic"><Icon name="trending-up" /></div>
          <h3>{L.unternehmensberatung.titel}</h3>
          <p>{L.unternehmensberatung.text}</p>
          {L.unternehmensberatung.zusatz && <p class="feat-extra">{L.unternehmensberatung.zusatz}</p>}
        </div>
        <div class="feat-visual fv-graph" aria-hidden="true">
          <svg class="fg-svg" viewBox="0 0 300 180" fill="none">
            <defs>
              <linearGradient id="fgGold" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="rgba(153,138,109,.38)"/><stop offset="1" stop-color="rgba(153,138,109,0)"/></linearGradient>
              <linearGradient id="fgRed" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="rgba(180,88,63,.22)"/><stop offset="1" stop-color="rgba(180,88,63,0)"/></linearGradient>
            </defs>
            <path class="fg-rarea" d="M6 132 L40 128 L74 134 L108 126 L142 130 L176 122 L210 128 L244 134 L278 140 L294 146 L294 156 L6 156 Z" fill="url(#fgRed)"/>
            <path class="fg-garea" d="M6 120 L40 110 L74 116 L108 98 L142 104 L176 86 L210 78 L244 58 L278 44 L294 34 L294 156 L6 156 Z" fill="url(#fgGold)"/>
            <path class="fg-red" d="M6 132 L40 128 L74 134 L108 126 L142 130 L176 122 L210 128 L244 134 L278 140 L294 146" stroke="#b4583f" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
            <path class="fg-gold" d="M6 120 L40 110 L74 116 L108 98 L142 104 L176 86 L210 78 L244 58 L278 44 L294 34" stroke="#998a6d" stroke-width="2.4" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="244" cy="58" r="4" fill="#998a6d"/>
            <g class="fg-months"><text x="6" y="173">Jun</text><text x="80" y="173">Jul</text><text x="152" y="173">Aug</text><text x="222" y="173">Sep</text><text x="294" y="173" text-anchor="end">Okt</text></g>
          </svg>
          <span class="fg-pill">MIT <img src={u('/uploads/logos/logo-quer-ohne-claim.svg')} alt="Bentivegna"></span>
        </div>
        <div class="feat-accent"></div>
      </div>
      <!-- 2: Vermögen & Nachfolge -->
      <div class="feat-card">
        <div class="feat-top">
          <div class="feat-ic"><Icon name="gem" /></div>
          <h3>{L.vermoegen.titel}</h3>
          <p>{L.vermoegen.text}</p>
        </div>
        <div class="feat-accent"></div>
      </div>
      <!-- 3: Prozesse & Kalkulation (hoch) -->
      <div class="feat-card feat-tall">
        <div class="feat-top">
          <div class="feat-ic"><Icon name="calculator" /></div>
          <h3>{L.prozesse.titel}</h3>
          <p>{L.prozesse.text}</p>
          <p class="feat-extra">{L.prozesse.kasten}</p>
        </div>
        <div class="feat-visual fv-bottom fv-bars" aria-hidden="true">
          <svg viewBox="0 0 300 120" preserveAspectRatio="xMidYMax meet">
            <defs>
              <linearGradient id="fb1" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#dcd6c8"/><stop offset="1" stop-color="#ccc4af"/></linearGradient>
              <linearGradient id="fb2" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#cdc4b1"/><stop offset="1" stop-color="#bcb098"/></linearGradient>
              <linearGradient id="fb3" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#b3a888"/><stop offset="1" stop-color="#998a6d"/></linearGradient>
              <linearGradient id="fb4" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#4f77b4"/><stop offset="1" stop-color="#345c9a"/></linearGradient>
              <linearGradient id="fb5" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#3a4a7a"/><stop offset="1" stop-color="#273365"/></linearGradient>
            </defs>
            <line x1="6" y1="108" x2="294" y2="108" stroke="#e2dcd0" stroke-width="1.5"/>
            <path class="fvb" d="M12 108 L12 82 Q12 76 18 76 L46 76 Q52 76 52 82 L52 108 Z" fill="url(#fb1)"/>
            <path class="fvb" d="M71 108 L71 70 Q71 64 77 64 L105 64 Q111 64 111 70 L111 108 Z" fill="url(#fb2)"/>
            <path class="fvb" d="M130 108 L130 56 Q130 50 136 50 L164 50 Q170 50 170 56 L170 108 Z" fill="url(#fb3)"/>
            <path class="fvb" d="M189 108 L189 40 Q189 34 195 34 L223 34 Q229 34 229 40 L229 108 Z" fill="url(#fb4)"/>
            <path class="fvb" d="M248 108 L248 24 Q248 18 254 18 L282 18 Q288 18 288 24 L288 108 Z" fill="url(#fb5)"/>
            <g class="fvdots">
              <circle cx="32" cy="76" r="3" fill="#fff" stroke="#ccc4af" stroke-width="1.6"/>
              <circle cx="91" cy="64" r="3" fill="#fff" stroke="#bcb098" stroke-width="1.6"/>
              <circle cx="150" cy="50" r="3" fill="#fff" stroke="#998a6d" stroke-width="1.6"/>
              <circle cx="209" cy="34" r="3" fill="#fff" stroke="#345c9a" stroke-width="1.6"/>
              <circle cx="268" cy="18" r="3.6" fill="#273365" stroke="#fff" stroke-width="1.8"/>
            </g>
          </svg>
        </div>
        <div class="feat-accent"></div>
      </div>
      <!-- 4: Liquidität -->
      <div class="feat-card">
        <div class="feat-top">
          <div class="feat-ic"><Icon name="chart-column" /></div>
          <h3>{L.liquiditaet.titel}</h3>
          <p>{L.liquiditaet.text}</p>
        </div>
        <div class="feat-accent"></div>
      </div>
      <!-- 5: Mitarbeiter -->
      <div class="feat-card">
        <div class="feat-top">
          <div class="feat-ic"><Icon name="users" /></div>
          <h3>{L.mitarbeiter.titel}</h3>
          <p>{L.mitarbeiter.text}</p>
        </div>
        <div class="feat-accent"></div>
      </div>
      <!-- 6: Steuerstrategie & Struktur (breit, gleichwertige Hauptkarte) -->
      <div class="feat-card feat-wide feat-main">
        <div class="feat-top">
          <div class="feat-ic"><Icon name="network" /></div>
          <h3>{L.steuerstrategie.titel}</h3>
          <p set:html={md(L.steuerstrategie.text)} />
        </div>
        <div class="fv-struct" aria-hidden="true">
          <svg viewBox="0 0 340 214" fill="none">
            <path class="sl" d="M112 172 C 140 172, 140 118, 158 118" stroke="#998a6d" stroke-width="2" stroke-linecap="round"/>
            <path class="sl l2" d="M226 96 C 246 96, 246 52, 262 52" stroke="#345c9a" stroke-width="2" stroke-linecap="round"/>
            <g class="sn s1"><rect x="2" y="150" width="112" height="44" rx="9" fill="#f0efeb" stroke="#ccc4af"/><text x="58" y="177" text-anchor="middle" font-size="12.5" font-weight="700" fill="#273365">{L.steuerstrategie.grafik[0]}</text></g>
            <g class="sn s2"><rect x="158" y="96" width="84" height="44" rx="9" fill="#345c9a"/><text x="200" y="123" text-anchor="middle" font-size="14" font-weight="800" fill="#fff">{L.steuerstrategie.grafik[1]}</text></g>
            <g class="sn s3"><rect x="246" y="22" width="92" height="52" rx="10" fill="#273365"/><text x="292" y="53" text-anchor="middle" font-size="14" font-weight="800" fill="#fff">{L.steuerstrategie.grafik[2]}</text><text x="292" y="16" text-anchor="middle" font-size="10" font-weight="700" fill="#998a6d" letter-spacing="1.2">100+ BEGLEITET</text></g>
          </svg>
        </div>
        <div class="feat-accent"></div>
      </div>
    </div>
  </div>
</section>



<!-- ============ KONTAKTBLOCK: So arbeiten wir ============ -->
<section class="section praxis">
  <div class="wrap">
    <div class="prx-band reveal">
      <div class="prx-copy">
        <span class="eyebrow">{S.kontaktblock.eyebrow}</span>
        <h2>{S.kontaktblock.titel} <span class="serif-accent prx-accent">{S.kontaktblock.titel_akzent}</span></h2>
        <p>{S.kontaktblock.text}</p>
        <a href={anfrage} class="btn btn--gold" data-track="cta_kontaktblock">{S.kontaktblock.button} <span class="arr"></span></a>
      </div>
      <div class="prx-img"><img src={u(S.kontaktblock.bild)} alt={S.kontaktblock.bild_alt} loading="lazy"></div>
    </div>
    <div class="prx-extra">
      <div class="feat-card feat-wide">
        <div class="feat-top">
          <div class="feat-ic"><Icon name="sparkles" /></div>
          <h3>{S.kontaktblock.ki_titel}</h3>
          <p>{S.kontaktblock.ki_text}</p>
        </div>
        <div class="feat-visual fv-right fv-net" aria-hidden="true">
          <span class="ai-doc d1"><Icon name="file-text" /></span>
          <span class="ai-doc d2"><Icon name="file-text" /></span>
          <span class="ai-doc d3"><Icon name="file-text" /></span>
          <span class="ai-spark s1"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l1.8 5.2L19 9l-5.2 1.8L12 16l-1.8-5.2L5 9l5.2-1.8z"/></svg></span>
          <span class="ai-spark s2"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l1.8 5.2L19 9l-5.2 1.8L12 16l-1.8-5.2L5 9l5.2-1.8z"/></svg></span>
          <span class="ai-hub"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.5l1.7 4.8L18.5 9l-4.8 1.7L12 15.5l-1.7-4.8L5.5 9l4.8-1.7z"/><path d="M18.5 13.5l.8 2.2 2.2.8-2.2.8-.8 2.2-.8-2.2-2.2-.8 2.2-.8z"/></svg></span>
        </div>
        <div class="feat-accent"></div>
      </div>
