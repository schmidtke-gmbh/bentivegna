<script>
  // Nutzenzeile im Hero: Satzende wechselt in Endlosschleife durch alle Punkte (letzter Eintrag ist eine Kopie des ersten,
  // damit der Übergang nahtlos ist). Der Strich darunter wird jeweils so lang wie das eingeblendete Wort.
  const hw = document.querySelector<HTMLElement>('[data-wechsel]');
  const lauf = hw?.querySelector<HTMLElement>('.hw-lauf');
  const strich = hw?.querySelector<HTMLElement>('.hw-strich');
  if (hw && lauf && strich && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const teile = [...lauf.children] as HTMLElement[];
    const n = teile.length - 1;
    const SCHRITT = 2600, STEHEN = 0.75, EASE = 'cubic-bezier(.65,0,.35,1)';
    let aText: Animation | undefined, aStrich: Animation | undefined;
    const bauen = () => {
      const zeit = aText?.currentTime ?? 0;
      aText?.cancel(); aStrich?.cancel();
      const breit = lauf.offsetWidth || 1;
      const w = teile.map((t) => (t.offsetWidth / breit).toFixed(4));
      if (n < 1) { strich.style.transform = `scaleX(${w[0]})`; return; }
      const fText: Keyframe[] = [], fStrich: Keyframe[] = [];
      for (let k = 0; k < n; k++) {
        fText.push({ offset: k / n, transform: `translateY(${-k * 1.3}em)` });
        fText.push({ offset: (k + STEHEN) / n, transform: `translateY(${-k * 1.3}em)`, easing: EASE });
        fStrich.push({ offset: k / n, transform: `scaleX(${w[k]})` });
        fStrich.push({ offset: (k + STEHEN) / n, transform: `scaleX(${w[k]})`, easing: EASE });
      }
      fText.push({ offset: 1, transform: `translateY(${-n * 1.3}em)` });
      fStrich.push({ offset: 1, transform: `scaleX(${w[n]})` });
      const opt: KeyframeAnimationOptions = { duration: n * SCHRITT, iterations: Infinity };
      aText = lauf.animate(fText, opt);
      aStrich = strich.animate(fStrich, opt);
      aText.currentTime = aStrich.currentTime = zeit;
    };
    strich.style.transform = `scaleX(${(teile[0].offsetWidth / (lauf.offsetWidth || 1)).toFixed(4)})`;
    (document.fonts ? document.fonts.ready : Promise.resolve()).then(bauen);
    let warte = 0;
    addEventListener('resize', () => { clearTimeout(warte); warte = window.setTimeout(bauen, 150); });
  }
</script>
<script>
  // WhatsApp-Handy: HyperFrames-Film im Bildschirm, läuft nur sichtbar und nicht bei reduzierter Bewegung.
  // Ohne Film (reduzierte Bewegung, Autoplay blockiert) bleibt der Chat aus dem CMS sichtbar.
  // Entwicklung: gestapelte Karten. Die zweite Karte schiebt sich beim Scrollen über die erste, die erste tritt leicht zurück.
  const stapel = document.querySelector<HTMLElement>('[data-stapel]');
  if (stapel && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const karten = [...stapel.querySelectorAll<HTMLElement>('.uz-karte')];
    let warteStapel = false;
    const stapeln = () => {
      warteStapel = false;
      karten.forEach((k, i) => {
        const naechste = karten[i + 1];
        const innen = k.querySelector<HTMLElement>('.uz-karte-innen');
        if (!naechste || !innen) return;
        const a = k.getBoundingClientRect(), b = naechste.getBoundingClientRect();
        const p = Math.min(1, Math.max(0, 1 - (b.top - a.top) / a.height));
        innen.style.transform = p > 0 ? `scale(${(1 - 0.05 * p).toFixed(4)})` : '';
        innen.style.filter = p > 0 ? `brightness(${(1 - 0.06 * p).toFixed(3)})` : '';
        const v = innen.querySelector<HTMLVideoElement>('video');
        if (v && p > 0.92 && !v.paused) v.pause();
      });
    };
    addEventListener('scroll', () => { if (!warteStapel) { warteStapel = true; requestAnimationFrame(stapeln); } }, { passive: true });
    addEventListener('resize', stapeln);
    stapeln();
  }
  // Entwicklung: zwei HyperFrames-Filme in den Karten. Bei reduzierter Bewegung bleibt das Schlussbild stehen.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    const beobachter = new IntersectionObserver((eintraege) => {
      eintraege.forEach((e) => { const v = e.target as HTMLVideoElement; if (e.isIntersecting) v.play().catch(() => {}); else v.pause(); });
    }, { threshold: 0.35 });
    document.querySelectorAll<HTMLVideoElement>('video[data-film]').forEach((v) => { if (v.dataset.startbild) v.poster = v.dataset.startbild; beobachter.observe(v); });
  }
  const film = document.querySelector<HTMLVideoElement>('[data-wa-film]');
  if (film && !matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    film.classList.add('an');
    new IntersectionObserver((eintraege) => {
      eintraege.forEach((e) => {
        if (e.isIntersecting) film.play().catch(() => film.classList.remove('an'));
        else film.pause();
      });
    }, { threshold: 0.2 }).observe(film);
  }
</script>
