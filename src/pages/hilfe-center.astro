---
// Tax Help Center von fragdeinekanzlei.de. Wird direkt beim Aufruf geladen (Wunsch Kanzlei, 11.11.2026).
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { u } from '../lib/site';
const src = 'https://www.fragdeinekanzlei.de/?visitor.kommunikation=false&visitor.duo=true&visitor.meineSteuern=true&visitor.tabula=false&visitor.personal=true&visitor.erechnung=true';
---
<Base titel="Hilfe-Center für Mandanten | Bentivegna" beschreibung="Anleitungen für Mandanten: DATEV Unternehmen online, DATEV DUO, Meine Steuern, Personal und E-Rechnung." pfad="/hilfe-center/">
  <section class="page-head">
    <img class="wm" src={u('/uploads/logos/schild-mono.svg')} alt="" aria-hidden="true">
    <div class="wrap">
      <span class="eyebrow">Für Mandanten</span>
      <h1 style="margin-top:16px">Hilfe-Center</h1>
      <p class="lead">Schritt-für-Schritt-Anleitungen zu DATEV Unternehmen online, Belegen, Personal und E-Rechnung. Schnell nachgeschlagen, ohne Anruf.</p>
    </div>
  </section>
  <section class="section" style="padding-top:40px">
    <div class="wrap">
      <div class="hc-box geladen" id="hcBox">
        <iframe src={src} title="Hilfe-Center" allowfullscreen></iframe>
      </div>
      <p class="hc-hinweis">Das Hilfe-Center wird von fragdeinekanzlei.de bereitgestellt. Mehr dazu in der <a href={u('/datenschutz/')}>Datenschutzerklärung</a>. <a class="hc-extern" href={src} target="_blank" rel="noopener">In neuem Tab öffnen <Icon name="external-link" /></a></p>
    </div>
  </section>
</Base>
<style is:global>
  .hc-box{border:1px solid var(--line);border-radius:14px;background:#fff;box-shadow:var(--shadow-s);min-height:60vh;display:flex;align-items:center;justify-content:center;overflow:hidden}
  .hc-box.geladen{display:block;min-height:0}
  .hc-box iframe{display:block;width:100%;height:80vh;min-height:620px;border:0}
  .hc-hinweis{margin-top:14px;font-size:.88rem;color:var(--muted);text-align:center}
  .hc-hinweis a{color:var(--navy);text-decoration:underline}
  .hc-start{max-width:560px;text-align:center;padding:50px 24px;display:flex;flex-direction:column;align-items:center;gap:14px}
  .hc-start h2{font-size:1.6rem}
  .hc-start p{color:var(--muted)}
  .hc-start a{color:var(--navy);text-decoration:underline}
  .hc-extern{display:inline-flex;align-items:center;gap:6px;font-size:.9rem}
  .hc-extern .ico{width:14px;height:14px}
</style>
