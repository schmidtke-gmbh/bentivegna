---
// Übersicht der drei Gestaltungsvarianten A bis C (nicht verlinkt, noindex).
import Uebersicht from '../../../components/entwurf/VariantenUebersicht.astro';
import { u } from '../../../lib/site';

const liste = [
  { k: 'live', marke: 'Jetzt', name: 'Aktueller Stand', kurz: 'Die Startseite, wie sie gerade auf der Vorschau steht. Aus B übernommen: Schild bei „Für wen wir arbeiten“ und bei den Fragen, Logo-Streifen bei den Kundenergebnissen, dazu das Schild im Problem-Bereich.', url: u('/') },
  { k: 'a', name: 'Bilder', kurz: 'Echte Fotos aus der Kanzlei an drei Stellen: „Keine Sorge …“ als großes Foto vom Team an der Kaffeebar mit Navy-Schleier, ein Bildband „Einblick in die Kanzlei“ vor dem Team, das beim Scrollen seitlich gleitet, und Domenico am Besprechungstisch im Schlussbereich.', plus: 'Am persönlichsten. Man sieht, wer hinter der Kanzlei steht.', minus: 'Braucht gute, helle Fotos; die Seite wird etwas länger.', url: u('/entwurf/gestaltung/a/') },
  { k: 'b', name: 'Logo-Motive', kurz: 'Das Schild aus dem Logo zieht sich als roter Faden durch die Seite: schwebend neben „Für wen wir arbeiten“, bei den Fragen und am Kontaktbereich, abwechselnd rechts und links. Dazu die schrägen Streifen des Logos als feines Muster in den dunklen Bereichen (Kennzahlen und Referenzen).', plus: 'Starke Wiedererkennung, bleibt ruhig und markentreu.', minus: 'Wirkt dezenter als Fotos.', url: u('/entwurf/gestaltung/b/') },
  { k: 'c', name: 'Typografie', kurz: 'Große Wörter in der Serifenschrift als Wasserzeichen, die beim Scrollen langsam zur Seite gleiten: „Rentabel.“ hinter den Leistungen, „Klarheit.“ hinter dem Weg in 6 Stufen, „Ehrlich.“ bei „Für wen wir arbeiten und für wen nicht“.', plus: 'Edel und modern, typisch für hochwertige Webflow-Seiten.', minus: 'Nur sparsam einsetzen, sonst wird es unruhig.', url: u('/entwurf/gestaltung/c/') },
  { k: 'd', name: 'Fotos in Karten', kurz: 'Echte Kanzleifotos als Kopf der drei Leistungskarten ohne eigene Grafik: Domenico bei „Vermögen & Nachfolge“, der Arbeitsplatz mit zwei Bildschirmen bei „Liquidität“, das Team an der Kaffeebar bei „Mitarbeiter“. Dazu das Bentivegna-Logo auf der Glastür als Hintergrund im Schlussbereich, mit Navy-Schleier.', plus: 'Mehr Bild genau dort, wo bisher nur Text stand; die Seite wird nicht länger. Das Glastür-Foto zeigt die Marke in echten Räumen.', minus: 'Mit Fotos werden die Leistungskarten etwas höher. Weitere Fotos aus dem neuen Shooting (z. B. Steffi am Bildschirm) lassen sich einfach tauschen.', url: u('/entwurf/gestaltung/d/') },
];
---
<Uebersicht
  titel="Entwurf: Gestaltung | Bentivegna"
  pfad="/entwurf/gestaltung/"
  ueberschrift="Vier Vorschläge für mehr Bild und Gestaltung"
  text="Feedback: mehr Bilder oder Gestaltungselemente auf der Startseite. Inhalte sind überall gleich, nur die Gestaltung ändert sich. Jede Vorschau ist die echte Startseite, also scroll- und klickbar. Die Varianten lassen sich auch kombinieren, zum Beispiel A mit dem Schild aus B."
  liste={liste}
/>
