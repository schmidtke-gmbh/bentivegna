---
// Übersicht der fünf Header-Varianten A bis E (nicht verlinkt, noindex).
import Uebersicht from '../../../components/entwurf/VariantenUebersicht.astro';
import { u } from '../../../lib/site';
import { HEADER_VARIANTEN as V } from '../../../components/entwurf/header-varianten';

const liste = [
  { k: 'live', marke: 'Jetzt', name: 'Aktueller Stand', kurz: 'So sieht der Header auf der Vorschau gerade aus. Auf einem normalen Laptop stehen die Auszeichnungen erst nach dem Scrollen im Bild, unter der Gruppe bleibt eine Lücke.', url: u('/') },
  ...V.map((x) => ({ ...x, url: u(`/entwurf/header/${x.k}/`) }))
];
---
<Uebersicht
  titel="Entwurf: Header-Varianten | Bentivegna"
  pfad="/entwurf/header/"
  ueberschrift="Fünf Varianten für den Header"
  text="Ziel: Auf einem normalen Laptop sieht man ohne Scrollen sofort, worum es geht, wen Domenico berät, wie man Kontakt aufnimmt und welche Auszeichnungen die Kanzlei hat. Inhalte und Bilder sind überall gleich, nur die Anordnung ändert sich. Jede Vorschau ist eine echte Seite, also auch klickbar."
  liste={liste}
/>
