  @media(prefers-reduced-motion:reduce){.nv *{transition:none!important;animation:none!important}}
</style>

<script>
  // Animationen starten, sobald eine Variante sichtbar wird (im echten Hero: beim Laden)
  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('an'); io.unobserve(e.target); } }), { threshold: 0.4 });
  document.querySelectorAll('[data-nv]').forEach((el) => io.observe(el));
</script>
