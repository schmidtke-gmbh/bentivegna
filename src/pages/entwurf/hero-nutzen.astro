---
// Entwurfsseite (nicht verlinkt, nicht in Sitemap, noindex): zehn Varianten für Nutzenzeile und YouTube im Hero der Startseite.
import Base from '../../layouts/Base.astro';
import Brand from '../../components/Brand.astro';
import { u, E } from '../../lib/site';
import S from '../../data/startseite.json';

const B = S.hero.bullets;
const kanal = 'Bentivegna Steuerrecht';
const yt = E.youtube;
const videos = [
  { id: '3KwVzoi7ya0', titel: 'Warum Steuerberatung nicht reicht und du Steuergestaltung brauchst' },
  { id: 'KVNro_nw_FM', titel: '4 essenzielle Steuer-Basics für deine Liquidität als Unternehmen' },
  { id: 'G_9AFXrkDc0', titel: 'GmbH-Gesellschafter aufgepasst: Diese Steuerregel rettet dir Vermögen' },
];
const watch = (id: string) => `https://www.youtube.com/watch?v=${id}`;
const thumb = (id: string) => u(`/uploads/youtube/${id}.jpg`);
const icons = [u('/uploads/nutzen/zahlen.webp'), u('/uploads/nutzen/liquiditaet.webp'), u('/uploads/nutzen/steuern.webp')];

const V = [
  { name: 'Messgeräte', text: 'Drei kleine Instrumente aus der SHK-Welt statt Häkchen: Balkenanzeige für die Zahlen, Manometer für die Liquidität, Wasserwaage für die Steuern. Beim Erscheinen wachsen die Balken, die Nadel schwingt, die Blase pendelt sich ein.', bewegung: 'Einmal beim Laden, dann Ruhe', material: 'SVG im Code' },
  { name: '3D-Motive', text: 'Drei eigene Illustrationen aus Higgsfield im Stil des Selbstchecks: Tablet mit Lupe, Manometer mit Wassertank, Holding-Blöcke mit Schild und Wasserwaage. Darunter eine Video-Karte mit echtem Vorschaubild vom Kanal.', bewegung: 'Leichtes Anheben beim Darüberfahren', material: 'Higgsfield, echtes YouTube-Vorschaubild' },
  { name: 'Konkret statt Floskel', text: 'Die Punkte werden messbar: fünf Kennzahlen im Monat, dreizehn Wochen Liquidität im Voraus, eine Struktur. Die Zahlen stammen aus Domenicos Selbstcheck und müssten von ihm als Leistungsversprechen bestätigt werden.', bewegung: 'Keine', material: 'Typografie', klaeren: 'Zahlen von Domenico bestätigen lassen' },
  { name: 'Vorher, nachher', text: 'Jeder Punkt zeigt kurz, wie es heute oft ist, und wird dann zur Lösung. Die Sätze stammen aus Domenicos Selbstcheck und sprechen SHK-Unternehmer direkt an. Darüberfahren zeigt das Vorher noch einmal.', bewegung: 'Einmal nacheinander, beim Darüberfahren wiederholbar', material: 'Texte aus dem Selbstcheck', klaeren: 'Satz zu Steuern ist ein Textvorschlag' },
  { name: 'Wechselzeile', text: 'Ein Satz, dessen Ende einmal durch die drei Punkte läuft wie ein Zählwerk und dann stehen bleibt. Im Stil des HyperFrames-Films der Karriereseite, sehr ruhig, nimmt kaum Platz weg.', bewegung: 'Einmal beim Laden, beim Darüberfahren erneut', material: 'Typografie, GSAP-artige Abfolge in CSS' },
  { name: 'BWA-Zeilen', text: 'Gesetzt wie eine Auswertung: drei Zeilen mit Führungspunkten bis zum Ergebnis, gezeichnete Häkchen in Braun. Wirkt nach Kanzlei statt nach App. YouTube als Fußnote mit kleinem Vorschaubild.', bewegung: 'Häkchen zeichnen sich einmal', material: 'Typografie, SVG' },
  { name: 'YouTube-Regal', text: 'Die Punkte stehen ruhig in einer Zeile, darunter drei echte Videos vom Kanal mit Titel. Der Kanal wird damit vom Etikett zum Beweis: Hier erklärt jemand wirklich. Videos öffnen auf YouTube, nichts lädt vorher von Google.', bewegung: 'Keine', material: 'Echte Vorschaubilder, lokal gespeichert' },
  { name: 'Domenico erklärt', text: 'Eine einzige große Video-Karte mit Domenico, Titel und Abspielknopf, die drei Punkte als Schlagworte darauf. Persönlich und klar, der Kanal wird zum zweiten Einstieg neben dem Analysegespräch.', bewegung: 'Abspielknopf reagiert auf Darüberfahren', material: 'Kanzleifoto, echter Videotitel' },
  { name: 'Rohrleitung', text: 'Die drei Punkte hängen an einer Kupferleitung mit Messing-Muffen, wie der Fortschritt im Selbstcheck. Einmal fließt Wasser von links nach rechts, und jeder Punkt leuchtet auf, wenn es ankommt.', bewegung: 'Einmal beim Laden', material: 'CSS, Anlehnung an den Selbstcheck' },
  { name: 'Wappen-Streifen', text: 'Statt Häkchen steht vor jedem Punkt ein kleines Streifen-Zeichen aus dem Logo im 14-Grad-Winkel. Leise, eigen, sofort Bentivegna. YouTube in Navy und Beige statt in grellem Rot, das rote Symbol bleibt klein.', bewegung: 'Streifen schieben sich einmal ein', material: 'Bildmarke als SVG' },
];
---
<Base titel="Entwurf: Nutzenzeile und YouTube im Hero | Bentivegna" beschreibung="Interne Entwurfsseite" pfad="/entwurf/hero-nutzen/" bodyClass="page-entwurf" noindex={true}>
<section class="nv-kopf">
  <div class="wrap">
    <h1>Nutzenzeile und YouTube im Hero</h1>
    <p>Zehn Varianten für den Bereich unter den Buttons. Links jeweils so, wie es im Hero stünde, rechts kurz erklärt. Die Animationen starten, sobald eine Variante ins Bild scrollt.</p>
    <ol class="nv-sprung">{V.map((v, i) => <li><a href={`#v${i + 1}`}>{i + 1}. {v.name}</a></li>)}</ol>
  </div>
</section>

{V.map((v, i) => (
  <section class={`nv-block`} id={`v${i + 1}`}>
    <div class="wrap nv-grid">
      <div class="nv-hero">
        <p class="hero-sub">{S.hero.subline}</p>
        <div class="hero-cta">
          <a href="#" class="btn btn--gold">{S.hero.button_primaer} <span class="arr"></span></a>
          <a href="#" class="btn btn--ghost">{S.hero.button_sekundaer} <span class="arr"></span></a>
        </div>

        {i === 0 && (
          <div class="nv nv1" data-nv>
            <div class="nv1-leiste">
              <div class="nv1-z">
                <svg class="nv1-bars" viewBox="0 0 60 40" aria-hidden="true">{[12, 18, 15, 26, 34].map((h, k) => <rect x={k * 12 + 2} y={40 - h} width="8" height={h} rx="1.5" style={`--k:${k}`} />)}<line x1="0" y1="39.5" x2="60" y2="39.5" /></svg>
                <span>{B[0]}</span>
              </div>
              <div class="nv1-z">
                <svg class="nv1-mano" viewBox="0 0 44 44" aria-hidden="true"><circle cx="22" cy="22" r="20" class="r" /><circle cx="22" cy="22" r="16.5" class="f" />{[-120, -80, -40, 0, 40, 80, 120].map((w) => <line x1="22" y1="8" x2="22" y2="11" transform={`rotate(${w} 22 22)`} class="t" />)}<path d="M18 33a9 9 0 0 1 8 0" class="ok" /><g class="nd"><path d="M22 9.5 23.3 22 22 25 20.7 22Z" /></g><circle cx="22" cy="22" r="2.4" class="hub" /></svg>
                <span>{B[1]}</span>
              </div>
              <div class="nv1-z">
                <svg class="nv1-lot" viewBox="0 0 64 22" aria-hidden="true"><rect x="1" y="3" width="62" height="16" rx="3" class="k" /><rect x="22" y="6" width="20" height="10" rx="5" class="v" /><line x1="28" y1="6" x2="28" y2="16" class="m" /><line x1="36" y1="6" x2="36" y2="16" class="m" /><ellipse cx="32" cy="11" rx="3.4" ry="3" class="b" /></svg>
                <span>{B[2]}</span>
              </div>
            </div>
            <a class="nv1-yt" href={yt} target="_blank" rel="noopener"><span class="ic"><Brand name="youtube" class="" /></span><span><b>{kanal} auf YouTube</b> {E.youtube_titel}</span></a>
          </div>
        )}

        {i === 1 && (
          <div class="nv nv2" data-nv>
            <ul class="nv2-reihe">{B.map((b, k) => <li><img src={icons[k]} alt="" width="120" height="110" loading="lazy" /><span>{b}</span></li>)}</ul>
            <a class="nv2-video" href={watch(videos[0].id)} target="_blank" rel="noopener">
              <span class="th"><img src={thumb(videos[0].id)} alt="" loading="lazy" width="534" height="300" /><i class="play" aria-hidden="true"></i></span>
              <span class="tx"><small><Brand name="youtube" class="" /> {kanal}</small><b>{videos[0].titel}</b></span>
            </a>
          </div>
        )}

        {i === 2 && (
          <div class="nv nv3" data-nv>
            <dl class="nv3-werte">
              <div><dt>5</dt><dd>Kennzahlen jeden Monat, verständlich erklärt</dd></div>
              <div><dt>13</dt><dd>Wochen Liquidität im Voraus geplant</dd></div>
              <div><dt>1</dt><dd>Steuerstruktur, die zu deinem Betrieb passt</dd></div>
            </dl>
            <a class="nv-textlink" href={yt} target="_blank" rel="noopener"><Brand name="youtube" class="" /> Domenico erklärt Steuern auf YouTube: {kanal}</a>
          </div>
        )}

        {i === 3 && (
          <div class="nv nv4" data-nv>
            <ul class="nv4-liste">
              <li style="--k:0"><span class="vor">Die Zahlen kommen einmal im Jahr vom Steuerberater.</span><span class="nach">Fünf Zahlen jeden Monat, und du entscheidest daraus.</span></li>
              <li style="--k:1"><span class="vor">Das Konto entscheidet, was geht.</span><span class="nach">Der 13-Wochen-Plan liegt vor, die Steuer ist zurückgelegt.</span></li>
              <li style="--k:2"><span class="vor">Die Steuer wird erklärt, wenn das Jahr vorbei ist.</span><span class="nach">Die Struktur steht, bevor die Steuer entsteht.</span></li>
            </ul>
            <a class="nv-textlink" href={watch(videos[1].id)} target="_blank" rel="noopener"><Brand name="youtube" class="" /> Wie das geht, zeigt Domenico auf YouTube</a>
          </div>
        )}

        {i === 4 && (
          <div class="nv nv5" data-nv>
            <p class="nv5-satz">Für dich heißt das: <span class="slot" aria-hidden="true"><span class="lauf"><span>{B[0]}.</span><span>{B[1]}.</span><span>{B[2]}.</span><span>{B[0]}.</span></span></span><span class="sr">{B.join(', ')}.</span></p>
            <a class="nv5-yt" href={yt} target="_blank" rel="noopener"><span class="ic"><Brand name="youtube" class="" /></span>{kanal}<span class="sub">{E.youtube_titel}</span></a>
          </div>
        )}

        {i === 5 && (
          <div class="nv nv6" data-nv>
            <ul class="nv6-zeilen">
              {[['Deine Zahlen', 'monatlich klar'], ['Deine Liquidität', 'im Griff'], ['Deine Steuern', 'gestaltet']].map(([a, b], k) => (
                <li style={`--k:${k}`}><span class="a">{a}</span><span class="dots" aria-hidden="true"></span><span class="b">{b}</span><svg class="hk" viewBox="0 0 22 18" aria-hidden="true"><path d="M2 10.5 8 16 20 2" /></svg></li>
              ))}
            </ul>
            <a class="nv6-fuss" href={watch(videos[0].id)} target="_blank" rel="noopener"><img src={thumb(videos[0].id)} alt="" width="96" height="54" loading="lazy" /><span>Zum Nachschauen auf YouTube: <b>{videos[0].titel}</b></span></a>
          </div>
        )}

        {i === 6 && (
          <div class="nv nv7" data-nv>
            <p class="nv7-punkte">{B.map((b) => <span>{b}</span>)}</p>
            <div class="nv7-kopf"><span><Brand name="youtube" class="" /> {kanal}</span><a href={yt} target="_blank" rel="noopener">Alle Videos ansehen</a></div>
            <ul class="nv7-regal">{videos.map((v) => <li><a href={watch(v.id)} target="_blank" rel="noopener"><span class="th"><img src={thumb(v.id)} alt="" loading="lazy" width="534" height="300" /><i class="play" aria-hidden="true"></i></span><span class="t">{v.titel}</span></a></li>)}</ul>
          </div>
        )}

        {i === 7 && (
          <div class="nv nv8" data-nv>
            <a class="nv8-karte" href={watch(videos[0].id)} target="_blank" rel="noopener">
              <img src={u('/uploads/domenico-portrait.jpg')} alt="" loading="lazy" width="1600" height="1066" />
              <span class="ov"></span>
              <span class="play" aria-hidden="true"><svg width="18" height="22" viewBox="0 0 22 26"><path d="M21 11.27a2 2 0 0 1 0 3.46L3 24.66A2 2 0 0 1 0 22.93V3.07A2 2 0 0 1 3 1.34L21 11.27Z" fill="#273365" /></svg></span>
              <span class="tx"><small><Brand name="youtube" class="" /> Domenico erklärt auf YouTube</small><b>{videos[0].titel}</b><span class="tags">{B.map((b) => <span>{b}</span>)}</span></span>
            </a>
          </div>
        )}

        {i === 8 && (
          <div class="nv nv9" data-nv>
            <div class="nv9-rohr" aria-hidden="true"><span class="wasser"></span><i style="left:16.66%"></i><i style="left:50%"></i><i style="left:83.33%"></i></div>
            <ul class="nv9-punkte">{B.map((b, k) => <li style={`--k:${k}`}>{b}</li>)}</ul>
            <a class="nv-textlink" href={yt} target="_blank" rel="noopener"><Brand name="youtube" class="" /> {kanal}: {E.youtube_titel}</a>
          </div>
        )}

        {i === 9 && (
          <div class="nv nv10" data-nv>
            <ul class="nv10-liste">{B.map((b, k) => <li style={`--k:${k}`}><svg viewBox="0 0 20 16" aria-hidden="true"><path d="M0 2 20 7V11L0 6Z" /><path d="M0 9 20 14V16H17L0 13Z" class="b2" /></svg>{b}</li>)}</ul>
            <a class="nv10-yt" href={yt} target="_blank" rel="noopener"><span class="ic"><Brand name="youtube" class="" /></span><span><b>{kanal}</b><small>{E.youtube_titel}</small></span><span class="go">Kanal ansehen</span></a>
          </div>
        )}
      </div>
      <aside class="nv-info">
        <p class="nr">Variante {i + 1}</p>
        <h2>{v.name}</h2>
        <p>{v.text}</p>
        <dl>
          <div><dt>Bewegung</dt><dd>{v.bewegung}</dd></div>
          <div><dt>Material</dt><dd>{v.material}</dd></div>
          {v.klaeren && <div><dt>Zu klären</dt><dd>{v.klaeren}</dd></div>}
        </dl>
      </aside>
    </div>
  </section>
))}
</Base>

<style is:global>
  .page-entwurf .fab{display:none}
  .nv-kopf{padding:150px 0 40px;background:linear-gradient(180deg,#fff,var(--cool))}
  .nv-kopf h1{font-size:clamp(2rem,4vw,3rem);color:var(--navy)}
  .nv-kopf p{color:var(--muted);max-width:640px;margin-top:12px;font-size:1.08rem}
  .nv-sprung{display:flex;flex-wrap:wrap;gap:8px 18px;list-style:none;padding:0;margin:22px 0 0}
  .nv-sprung a{color:var(--navy);font-weight:700;font-size:.92rem;text-decoration:underline;text-decoration-color:var(--beige-l);text-underline-offset:4px}
  .nv-block{padding:70px 0;background:radial-gradient(800px 420px at 20% 0,#fff,rgba(255,255,255,0) 70%),linear-gradient(180deg,#f7f7f5,var(--cream));border-top:1px solid var(--line)}
  .nv-grid{display:grid;grid-template-columns:minmax(0,760px) minmax(0,1fr);gap:64px;align-items:start}
  .nv-hero .hero-sub{margin-top:0}
  .nv-info{position:sticky;top:120px;padding-top:6px}
  .nv-info .nr{color:var(--brown);font-weight:700}
  .nv-info h2{font-size:1.9rem;margin:4px 0 12px;color:var(--navy)}
  .nv-info p{color:var(--muted);line-height:1.65}
  .nv-info dl{margin-top:18px;display:grid;gap:8px}
  .nv-info dl div{display:grid;grid-template-columns:100px 1fr;gap:12px;border-top:1px solid var(--line);padding-top:8px;font-size:.92rem}
  .nv-info dt{font-weight:700;color:var(--navy)}
  .nv-info dd{color:var(--muted);margin:0}
  .nv{margin-top:30px}
  .nv-textlink{display:inline-flex;align-items:center;gap:9px;margin-top:22px;color:var(--navy);font-weight:700;font-size:.95rem;text-decoration:underline;text-decoration-color:var(--beige-l);text-underline-offset:5px;text-decoration-thickness:1.5px}
  .nv-textlink svg{width:20px;height:20px;color:#ff0033;flex:0 0 auto}
  .nv-textlink:hover{text-decoration-color:var(--brown)}
  .nv .play{position:absolute;left:50%;top:50%;width:46px;height:46px;margin:-23px 0 0 -23px;border-radius:50%;background:rgba(255,255,255,.94);box-shadow:0 6px 18px rgba(0,0,0,.25);transition:transform .25s var(--ease)}
  .nv .play::after{content:"";position:absolute;left:18px;top:14px;border-left:14px solid var(--navy);border-top:9px solid transparent;border-bottom:9px solid transparent}

  /* 1 Messgeräte */
  .nv1-leiste{display:grid;grid-template-columns:repeat(3,1fr);background:#fff;border:1px solid var(--line);border-radius:14px;box-shadow:0 10px 28px -14px rgba(20,29,58,.18)}
  .nv1-z{display:flex;align-items:center;gap:14px;padding:16px 18px}
  .nv1-z+.nv1-z{border-left:1px solid var(--line)}
  .nv1-z span{font-weight:700;color:var(--navy);font-size:.94rem;line-height:1.25}
  .nv1-z svg{flex:0 0 auto}
  .nv1-bars{width:46px;height:32px}
  .nv1-bars rect{fill:var(--blue);transform-box:fill-box;transform-origin:bottom;transform:scaleY(.15)}
  .nv1-bars rect:last-of-type{fill:var(--navy)}
  .nv1-bars line{stroke:var(--beige);stroke-width:1}
  .nv1-mano{width:40px;height:40px}
  .nv1-mano .r{fill:var(--navy)} .nv1-mano .f{fill:#fbfaf6} .nv1-mano .t{stroke:var(--navy);stroke-width:1.4;stroke-linecap:round}
  .nv1-mano .ok{fill:none;stroke:var(--brown);stroke-width:1.6}
  .nv1-mano .nd{transform-origin:22px 22px;transform:rotate(-125deg)} .nv1-mano .nd path{fill:var(--navy)} .nv1-mano .hub{fill:var(--brown)}
  .nv1-lot{width:52px;height:18px}
  .nv1-lot .k{fill:var(--navy)} .nv1-lot .v{fill:#d8e8c8;stroke:#fff;stroke-width:1} .nv1-lot .m{stroke:var(--navy);stroke-width:.8}
  .nv1-lot .b{fill:#fff;transform:translateX(-7px)}
  .nv1.an .nv1-bars rect{transform:scaleY(1);transition:transform .8s cubic-bezier(.2,.8,.3,1) calc(var(--k)*.09s)}
  .nv1.an .nv1-mano .nd{transform:rotate(48deg);transition:transform 1.4s cubic-bezier(.34,1.5,.5,1) .35s}
  .nv1.an .nv1-lot .b{animation:nvLot 1.6s cubic-bezier(.3,1.3,.5,1) .6s both}
  @keyframes nvLot{0%{transform:translateX(-7px)}45%{transform:translateX(4px)}70%{transform:translateX(-1.5px)}100%{transform:translateX(0)}}
  .nv1-yt{display:inline-flex;align-items:center;gap:10px;margin-top:16px;color:var(--muted);font-size:.9rem}
  .nv1-yt .ic{width:30px;height:30px;border-radius:8px;background:#ff0033;color:#fff;display:grid;place-items:center}
  .nv1-yt .ic svg{width:17px;height:17px}
  .nv1-yt b{color:var(--navy)}
  .nv1-yt:hover b{text-decoration:underline;text-underline-offset:4px}

  /* 2 3D-Motive */
  .nv2-reihe{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(3,1fr);gap:0}
  .nv2-reihe li{display:flex;flex-direction:column;align-items:flex-start;gap:6px;padding:0 18px}
  .nv2-reihe li:first-child{padding-left:0}
  .nv2-reihe li+li{border-left:1px solid var(--line)}
  .nv2-reihe img{width:92px;height:84px;object-fit:contain;filter:drop-shadow(0 10px 12px rgba(20,29,58,.12));transition:transform .35s var(--ease)}
  .nv2-reihe li:hover img{transform:translateY(-4px)}
  .nv2-reihe span{font-weight:700;color:var(--navy);font-size:.98rem;line-height:1.25}
  .nv2-video{display:grid;grid-template-columns:150px 1fr;gap:16px;align-items:center;margin-top:24px;max-width:520px;background:#fff;border:1px solid var(--line);border-radius:14px;padding:8px;box-shadow:0 10px 26px -16px rgba(20,29,58,.25)}
  .nv2-video .th{position:relative;display:block;border-radius:9px;overflow:hidden;aspect-ratio:16/9}
  .nv2-video .th img{width:100%;height:100%;object-fit:cover;display:block}
  .nv2-video .play{width:34px;height:34px;margin:-17px 0 0 -17px}
  .nv2-video .play::after{left:13px;top:10px;border-left-width:11px;border-top-width:7px;border-bottom-width:7px}
  .nv2-video small{display:flex;align-items:center;gap:6px;color:var(--muted);font-size:.8rem}
  .nv2-video small svg{width:16px;height:16px;color:#ff0033}
  .nv2-video b{display:block;color:var(--navy);font-size:.95rem;line-height:1.3;margin-top:3px}
  .nv2-video:hover .play{transform:scale(1.08)}

  /* 3 Konkret */
  .nv3-werte{display:grid;grid-template-columns:repeat(3,1fr);margin:0;border-top:1px solid var(--beige-l);border-bottom:1px solid var(--beige-l)}
  .nv3-werte div{padding:16px 18px 16px 0}
  .nv3-werte div+div{padding-left:18px;border-left:1px solid var(--beige-l)}
  .nv3-werte dt{font-family:var(--serif);font-weight:600;font-size:2.6rem;line-height:1;color:var(--navy);font-variant-numeric:lining-nums}
  .nv3-werte dd{margin:6px 0 0;color:var(--ink);font-weight:600;font-size:.92rem;line-height:1.35}

  /* 4 Vorher, nachher */
  .nv4-liste{list-style:none;padding:0;margin:0;display:grid;gap:10px}
  .nv4-liste li{position:relative;display:grid;padding:12px 16px 12px 44px;background:#fff;border:1px solid var(--line);border-radius:12px;min-height:50px;align-items:center;overflow:hidden}
  .nv4-liste li::before{content:"";position:absolute;left:16px;top:50%;width:14px;height:14px;margin-top:-7px;border-radius:50%;border:1.5px solid var(--beige);transition:background .4s,border-color .4s}
  .nv4-liste .vor,.nv4-liste .nach{grid-area:1/1;transition:opacity .45s,transform .45s var(--ease)}
  .nv4-liste .vor{color:var(--muted);text-decoration:line-through;text-decoration-color:rgba(153,138,109,.7);text-decoration-thickness:1.5px}
  .nv4-liste .nach{color:var(--navy);font-weight:700;opacity:0;transform:translateY(8px)}
  .nv4.an li .vor{opacity:0;transform:translateY(-8px);transition-delay:calc(.6s + var(--k)*.7s)}
  .nv4.an li .nach{opacity:1;transform:none;transition-delay:calc(.75s + var(--k)*.7s)}
