  @keyframes qzLot{0%{opacity:0;transform:rotate(-7deg) translateY(10px)}40%{opacity:1;transform:rotate(3deg)}70%{transform:rotate(-1.2deg)}100%{transform:none}}
  .qz-pause .gross{font-family:var(--serif);font-weight:600;font-size:clamp(3.2rem,9vw,4.6rem);line-height:1;color:var(--navy);animation:qzBloom .7s cubic-bezier(.3,1.4,.5,1) .2s both}
