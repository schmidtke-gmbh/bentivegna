    .qz-mass span{font-size:.6rem;letter-spacing:.06em;padding:0 5px 7px}
    .qz-vorschau{padding:18px 14px 14px;margin-top:-56px}
    .qz-weiter{position:sticky;bottom:12px;z-index:5}
    .qz-weiter .btn{width:100%;justify-content:center}
    .qz-weiter .btn>.arr{right:7px}
    .qz-ergebnis{padding:24px 16px 22px;border-radius:18px}
