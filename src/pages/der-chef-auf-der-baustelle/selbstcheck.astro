  }
  @media (prefers-reduced-motion:reduce){.qz *,.qz *::before,.qz *::after{animation:none!important;transition:none!important}}
  @media print{
    .nav,#progress,.mobile-menu,.mobile-overlay,footer,.fab,.qz-wrap,.qz-plan{display:none!important}
    .qz{padding:0;min-height:0;background:#fff}
    .qz::before{display:none}
    .qz-druck{display:block!important;font-family:var(--sans);color:#000;padding:10px}
    .qz-druck h1{font-size:20pt;margin:0 0 4pt}
    .qz-druck table{width:100%;border-collapse:collapse;margin-top:10pt;font-size:10.5pt}
    .qz-druck td,.qz-druck th{border-bottom:1px solid #ccc;padding:6pt 4pt;text-align:left;vertical-align:top}
  }
</style>

<script>
  // Inhalte aus dem Selbstcheck von Domenico Bentivegna (unverändert)
  const B = [
    { t: 'Der Inhaber', k: 'Inhaber', q: 'Wie viele Tage pro Woche stehst du selbst auf der Baustelle, und kennst du deine Zahlen?',
      a: ['Fünf Tage draußen. Die Zahlen kommen einmal im Jahr vom Steuerberater.',
          'Zwei bis drei Tage draußen. Die BWA kommt monatlich, wird gelesen, aber nichts folgt daraus.',
          'Höchstens ein Tag draußen. Fünf Zahlen jeden Monat, und du triffst Entscheidungen daraus.'] },
    { t: 'Die Aufträge', k: 'Aufträge', q: 'Weißt du, mit welchen Kunden du Geld verdienst, und sagst du Nein?',
      a: ['Jeder Auftrag wird angenommen. Wer der Auftraggeber ist, spielt keine Rolle.',
          'Du hast ein Gefühl für gute und schlechte Kunden und lehnst gelegentlich ab.',
          'Wunschkunde beschrieben, Kunden nach A, B und C sortiert, C-Kunden abgegeben, der Betrieb steht für etwas.'] },
    { t: 'Der Preis', k: 'Preis', q: 'Ist dein Stundensatz aus deinen Kosten kalkuliert, und wird jede Baustelle nachgerechnet?',
      a: ['Der Satz ist der Branchenschnitt. Nachkalkulation gibt es nicht.',
          'Der Satz ist kalkuliert. Nachgerechnet wird, wenn etwas schiefging.',
          'Eigener Satz, Preismodell passt zum Geschäft, jede Baustelle Soll gegen Ist.'] },
    { t: 'Die Liquidität', k: 'Liquidität', q: 'Weißt du, wie dein Konto in acht Wochen aussieht?',
      a: ['Das Konto entscheidet, was geht. Die Steuernachzahlung überrascht jedes Jahr.',
          'Abschläge bei großen Aufträgen, Mahnungen unregelmäßig, Steuer irgendwie eingeplant.',
          'Abschläge sind Standard, Mahnlauf läuft, 13-Wochen-Plan liegt vor, Steuer ist zurückgelegt.'] },
    { t: 'Die Leute', k: 'Leute', q: 'Läuft der Betrieb zwei Wochen ohne dich?',
      a: ['Nein. Jede Entscheidung geht über dich, auch die kleine.',
          'Es gibt einen Meister oder eine Büroleitung, aber wer wofür zuständig ist, weiß keiner genau.',
          'Rollen sind beschrieben, es gibt eine zweite Führungsebene, Urlaub ohne Handy ist möglich.'] },
    { t: 'Die Prozesse', k: 'Prozesse', q: 'Läuft ein Auftrag jedes Mal gleich durch den Betrieb, oder jedes Mal anders?',
      a: ['Jedes Mal anders. Der Ablauf ist in deinem Kopf.',
          'Software ist da, Abläufe sind halb dokumentiert, jeder macht es ein bisschen anders.',
          'Von der Anfrage bis zur Nachkalkulation ein fester Weg mit Prüfpunkten, dokumentiert, digital, Monat nach zehn Tagen abgeschlossen.'] }
  ];
  const KEY = 'chef-selbstcheck-v1';
  const root = document.getElementById('qz')!;
  const app = document.getElementById('qzApp')!;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const bild = (i: number) => root.dataset['b' + (i + 1)] || '';
  type State = { ist: number[]; ziel: number[]; fertig?: boolean };
  let state: State = { ist: [5, 5, 5, 5, 5, 5], ziel: [5, 5, 5, 5, 5, 5] };
  try { const s = localStorage.getItem(KEY); if (s) { const p = JSON.parse(s); if (p && p.ist && p.ziel && p.ist.length === 6) state = p; } } catch (e) { /* ohne Speicher */ }
  const speichern = () => { try { localStorage.setItem(KEY, JSON.stringify(state)); } catch (e) { /* ohne Speicher */ } };
  const track = (ev: string, d: Record<string, unknown> = {}) => window.bvTrack?.(ev, d);

  // Ablauf: Start, je Baustelle „heute“ und „Ziel“, zwei Zwischenschritte, Auswertung, Ergebnis
  type Schritt = { typ: 'start' | 'ist' | 'ziel' | 'pause' | 'laden' | 'ergebnis'; i?: number; p?: 'halbzeit' | 'fast' };
  const SCHRITTE: Schritt[] = [{ typ: 'start' }];
  B.forEach((_, i) => {
    SCHRITTE.push({ typ: 'ist', i }, { typ: 'ziel', i });
    if (i === 2) SCHRITTE.push({ typ: 'pause', p: 'halbzeit' });
    if (i === 4) SCHRITTE.push({ typ: 'pause', p: 'fast' });
  });
  SCHRITTE.push({ typ: 'laden' }, { typ: 'ergebnis' });
  let pos = 0;
  let letzterStand = 0;

  const anker = (v: number) => (v <= 4 ? 0 : v <= 7 ? 1 : 2);
  const ankerLabel = (v: number) => (v <= 4 ? 'So sieht eine Drei aus' : v <= 7 ? 'So sieht eine Sechs aus' : 'So sieht eine Neun aus');
  const startIndex = () => state.ist.findIndex((v) => v < 7);
  const fragenFertig = () => SCHRITTE.slice(1, pos + 1).filter((s) => s.typ === 'ist' || s.typ === 'ziel').length;
  const baustelleNr = (s: Schritt) => (s.i ?? 0) + 1;
  const wiederholung = (() => { const d = new Date(); d.setMonth(d.getMonth() + 6); return d; })();
  const datumText = wiederholung.toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' });

  // Manometer: 240 Grad Skala, 1 links unten, 10 rechts unten
  const winkel = (v: number) => -120 + ((v - 1) / 9) * 240;
  const pol = (r: number, w: number) => { const a = (w * Math.PI) / 180; return [100 + r * Math.sin(a), 100 - r * Math.cos(a)]; };
  const bogen = (r: number, w1: number, w2: number) => {
    const [x1, y1] = pol(r, w1), [x2, y2] = pol(r, w2);
    return `M${x1.toFixed(2)} ${y1.toFixed(2)}A${r} ${r} 0 ${w2 - w1 > 180 ? 1 : 0} 1 ${x2.toFixed(2)} ${y2.toFixed(2)}`;
  };
  const NADEL = 'M100 30L103.6 100L101.8 117H98.2L96.4 100Z';
  function mano(v: number, o: { label: string; ziel?: boolean; heute?: number; laden?: boolean }) {
    let skala = '';
    for (let s = 1; s <= 10; s += 0.5) {
      const w = winkel(s), gross = s % 1 === 0;
      const [x1, y1] = pol(gross ? 63 : 68, w), [x2, y2] = pol(73, w);
      skala += `<line class="tick${gross ? '' : ' k'}" x1="${x1.toFixed(1)}" y1="${y1.toFixed(1)}" x2="${x2.toFixed(1)}" y2="${y2.toFixed(1)}"/>`;
      if (gross) { const [tx, ty] = pol(53, w); skala += `<text class="ziff" x="${tx.toFixed(1)}" y="${ty.toFixed(1)}">${s}</text>`; }
    }
    const zonen = [['#ccc4af', 1, 4.5], ['#998a6d', 4.5, 7.5], ['#345c9a', 7.5, 10]]
      .map(([c, a, b]) => `<path class="zone" stroke="${c}" d="${bogen(79, winkel(+a), winkel(+b))}"/>`).join('');
    const geist = o.heute !== undefined ? `<g class="nadel geist" style="transform:rotate(${winkel(o.heute)}deg)"><path d="${NADEL}"/></g>` : '';
    return `<div class="qz-mano${o.ziel ? ' ziel' : ''}${o.laden ? ' laden' : ''}" aria-hidden="true"><svg viewBox="0 0 200 200">
      <defs>
        <radialGradient id="qzFace" cx="50%" cy="38%" r="62%"><stop offset="0" stop-color="#ffffff"/><stop offset="1" stop-color="#ece8de"/></radialGradient>
        <linearGradient id="qzRing" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#3b4b86"/><stop offset="1" stop-color="#1b244b"/></linearGradient>
        <linearGradient id="qzMessing" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ece3cc"/><stop offset=".5" stop-color="#b3a37f"/><stop offset="1" stop-color="#7c6e52"/></linearGradient>
      </defs>
      <circle cx="100" cy="100" r="97" fill="url(#qzRing)"/>
      <circle cx="100" cy="100" r="88.6" fill="none" stroke="rgba(255,255,255,.3)" stroke-width="1.2"/>
      <circle cx="100" cy="100" r="86" fill="url(#qzFace)"/>
      ${zonen}${o.ziel ? '<path class="bogen" id="qzBogen" d=""/>' : ''}${skala}
      <text class="lbl" x="100" y="127">${o.label.toUpperCase()}</text>
      ${geist}
      <g class="nadel"${o.laden ? '' : ` id="qzNadel" style="transform:rotate(${winkel(1) - 10}deg)"`}><path d="${NADEL}"/></g>
      <circle cx="100" cy="100" r="10" fill="url(#qzMessing)"/><circle cx="100" cy="100" r="3.6" fill="#5b5140"/>
      ${o.laden ? '' : `<text class="zahl" id="qzZahl" x="100" y="165">${v}</text><text class="einheit" x="100" y="180">VON 10</text>`}
      <path d="M33 96A67 67 0 0 1 96 33" fill="none" stroke="#fff" stroke-opacity=".6" stroke-width="5" stroke-linecap="round"/>
    </svg></div>`;
  }

  // Fortschritt als Rohrleitung: Wasser fließt bis zur aktuellen Baustelle, Muffen trennen die sechs Abschnitte
  function rohr(prozent: number, nr = 0, pause = false, laden = false) {
    const muffen = [1, 2, 3, 4, 5].map((k) => `<i class="muffe${!laden && prozent >= (k / 6) * 100 - 0.5 ? ' voll' : ''}" style="left:${(k / 6) * 100}%"></i>`).join('');
    const nummern = laden ? '' : B.map((_, k) => `<span class="nr${k < nr - 1 || (pause && k < nr) ? ' fertig' : k === nr - 1 && !pause ? ' jetzt' : ''}" style="left:${((k + 0.5) / 6) * 100}%">${k + 1}</span>`).join('');
    return `<div class="qz-rohr" role="progressbar" aria-label="Fortschritt" aria-valuemin="0" aria-valuemax="100" aria-valuenow="${prozent}">
      <span class="wasser" ${laden ? 'id="qzBalken" style="width:0"' : `data-ziel="${prozent}" style="width:${letzterStand}%"`}></span>${muffen}${nummern}</div>`;
  }

  function kopf(s: Schritt) {
    const prozent = Math.round((fragenFertig() - (s.typ === 'ist' || s.typ === 'ziel' ? 1 : 0)) / 12 * 100);
    const nr = baustelleNr(s);
    return `<div class="qz-top"><button type="button" class="qz-back" data-akt="zurueck">← zurück</button>
      <span class="qz-count">${s.typ === 'pause' ? 'Zwischenstand' : `Baustelle ${nr} von 6`}</span><span></span></div>
      ${rohr(prozent, nr, s.typ === 'pause')}`;
  }

  function raster(opts: { werte: boolean; bis?: number; start?: number; verzoegert?: boolean }) {
    return `<div class="qz-raster">${B.map((b, i) => {
      const leer = opts.bis !== undefined && i >= opts.bis;
      const v = state.ist[i], z = state.ziel[i];
      const cls = ['qz-zelle', leer ? 'leer' : 'fertig', opts.start === i ? 'start' : ''].join(' ');
      return `<div class="${cls}" style="--h:${v * 10}%;--z:${z * 10}%;--d:${opts.verzoegert ? 0.25 + i * 0.12 : 0}s">
        <span class="n">${i + 1}</span><span class="t">${b.k}</span>
        <div class="qz-bar"><div class="fill"></div><div class="ziel"></div>${opts.werte ? `<div class="wert">${v}</div>` : ''}</div></div>`;
    }).join('')}</div>`;
  }

  function startScreen() {
    const vorhanden = state.fertig;
    const beispiel = { ist: [3, 5, 4, 6, 2, 5], ziel: [5, 6, 6, 7, 4, 6] };
    const alt = state; state = { ...state, ...beispiel };
    const vorschau = raster({ werte: true, start: 0, verzoegert: true });
    state = alt;
    return `<div class="qz-screen qz-start">
      <div>
        <span class="qz-pill">Selbstcheck · Der Chef auf der Baustelle</span>
        <h1>Wo steht dein Betrieb <em>wirklich</em>?</h1>
        <p class="qz-lead">Sechs Baustellen, eine Zahl von 1 bis 10. Zu jeder Zahl steht, was sie bedeutet. <em>Ehrlich schlägt freundlich:</em> Die Note ist für dich, niemand sonst sieht sie.</p>
        <p class="qz-mass"><span>6 Baustellen</span><span>ca. 5 Minuten</span><span>bleibt auf deinem Gerät</span></p>
        <button type="button" class="btn btn--gold" data-akt="los">Selbstcheck starten <span class="arr"></span></button>
        ${vorhanden ? '<button type="button" class="qz-wieder" data-akt="ergebnis">Mein letztes Ergebnis ansehen</button>' : ''}
      </div>
      <div class="qz-buehne">
        <img class="qz-haus" src="${root.dataset.haus}" alt="" width="745" height="687">
        <div class="qz-vorschau"><span class="badge">Beispiel</span><p class="cap">Dein Bild am Ende</p>${vorschau}<p class="hint">Am Ende siehst du, an welcher Baustelle du anfangen solltest.</p></div>
      </div>
    </div>`;
  }

  function frageScreen(s: Schritt) {
    const i = s.i!, b = B[i], istZiel = s.typ === 'ziel';
    const v = istZiel ? state.ziel[i] : state.ist[i];
    const ersteFrage = i === 0 && !istZiel;
    return `<div class="qz-screen qz-card ${istZiel ? 'qz-ziel' : ''}">${kopf(s)}
      <div class="qz-q-grid">
        <div class="qz-q-vis">
          <figure class="qz-bild"><img src="${bild(i)}" alt=""></figure>
          ${mano(v, { label: b.k, ziel: istZiel, heute: istZiel ? state.ist[i] : undefined })}
        </div>
        <div class="qz-q-txt">
          <p class="qz-eyebrow">${istZiel ? '<b>Ziel</b> · in sechs Monaten' : '<b>Heute</b> · ehrlich eingeschätzt'}</p>
          <h2>${istZiel ? `Und in <em>sechs Monaten</em>?` : b.t}</h2>
          <p class="qz-frage">${istZiel ? `${b.t}: Welche Zahl willst du bis zum ${datumText} erreichen?` : b.q}</p>
          ${ersteFrage ? '<p class="qz-helfer">Dreh am Regler, bis die Zahl zu deinem Betrieb passt. Wenn du zwischen zwei Stufen schwankst, nimm die niedrigere.</p>' : ''}
          <div class="qz-skala">
            <div class="qz-range-wrap">
              ${istZiel ? `<span class="qz-heute-marke" id="qzMarke">heute ${state.ist[i]}</span>` : ''}
              <input class="qz-range" id="qzRange" type="range" min="1" max="10" step="1" value="${v}" aria-label="${b.t}, ${istZiel ? 'Ziel in sechs Monaten' : 'heute'}, 1 bis 10">
            </div>
            <div class="qz-ticks">${[1, 5, 10].map((t) => { const p = ((t - 1) / 9) * 100; return `<span style="left:calc(${p}% + ${(21 - (p / 100) * 42).toFixed(1)}px)">${t}</span>`; }).join('')}</div>
          </div>
          ${istZiel ? `<p class="qz-hinweis" id="qzHinweis"></p>` : `<div class="qz-anker" id="qzAnker"><b>${ankerLabel(v)}</b><p>${b.a[anker(v)]}</p></div>`}
          <div class="qz-weiter"><button type="button" class="btn btn--gold" data-akt="weiter">Weiter <span class="arr"></span></button></div>
        </div>
      </div>
    </div>`;
  }

  function pauseScreen(s: Schritt) {
    const halb = s.p === 'halbzeit';
    const bis = halb ? 3 : 5;
    return `<div class="qz-screen qz-card qz-pause">${kopf({ typ: 'pause', i: bis - 1 })}
      <img class="qz-pause-bild ${halb ? 'lot' : 'haus'}" src="${halb ? root.dataset.lot : root.dataset.haus}" alt="">
      <div class="gross">${bis}<small> von 6</small></div>
      <h2>${halb ? 'Halbzeit.' : 'Fast geschafft.'}</h2>
      <p>${halb ? 'Drei Baustellen hast du ehrlich bewertet. Noch drei, dann siehst du, wo du anfangen solltest.' : 'Eine Baustelle noch. Dann zeigt dir dein Bild, welche Baustelle zuerst dran ist.'}</p>
      ${halb ? '<blockquote>„Ehrlich schlägt freundlich.“</blockquote>' : ''}
      ${raster({ werte: true, bis, verzoegert: true })}
      <div class="qz-weiter"><button type="button" class="btn btn--gold" data-akt="weiter">Weiter <span class="arr"></span></button></div>
    </div>`;
  }

  function ladenScreen() {
    return `<div class="qz-screen qz-card qz-laden">
      ${mano(5, { label: 'Auswertung', laden: true })}
      <h2>Wir werten deine <em>sechs Baustellen</em> aus …</h2>
      <p class="zyklus" id="qzZyklus">Baustellen werden sortiert</p>
      ${rohr(0, 0, false, true)}
    </div>`;
  }

  function stempel() {
    const heute = new Date().toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric' });
    return `<div class="qz-stempel" aria-hidden="true"><svg viewBox="0 0 120 120">
      <defs><filter id="qzRau" x="-10%" y="-10%" width="120%" height="120%"><feTurbulence type="fractalNoise" baseFrequency=".85" numOctaves="2" seed="4"/><feDisplacementMap in="SourceGraphic" scale="2.4"/></filter>
      <path id="qzKreis" d="M60 60m-43 0a43 43 0 1 1 86 0a43 43 0 1 1-86 0"/></defs>
      <g filter="url(#qzRau)">
        <circle cx="60" cy="60" r="56" fill="none" stroke="currentColor" stroke-width="3"/>
        <circle cx="60" cy="60" r="50.5" fill="none" stroke="currentColor" stroke-width="1"/>
        <circle cx="60" cy="60" r="35" fill="none" stroke="currentColor" stroke-width="1"/>
        <text fill="currentColor" font-size="8.4" font-weight="800" letter-spacing="1.2" font-family="Source Sans 3, sans-serif"><textPath href="#qzKreis" textLength="266" lengthAdjust="spacing">SELBSTCHECK • SECHS BAUSTELLEN • </textPath></text>
        <text x="60" y="58" text-anchor="middle" fill="currentColor" font-size="12.5" font-weight="900" letter-spacing=".6" font-family="Source Sans 3, sans-serif">GEPRÜFT</text>
        <text x="60" y="72" text-anchor="middle" fill="currentColor" font-size="8.6" font-weight="700" font-family="Source Sans 3, sans-serif">${heute}</text>
      </g></svg></div>`;
  }

  function ergebnisScreen() {
    const st = startIndex();
    let urteil = '';
    if (st < 0) urteil = 'Alle sechs Baustellen stehen bei 7 oder höher. <strong>Dann ist Band 2 dran: die Struktur um den Betrieb.</strong>';
    else urteil = `Hier fängst du an: <strong>Baustelle ${st + 1}, ${B[st].t.replace(/^\S+/, (w) => w.toLowerCase())}.</strong> Es ist die vorderste Baustelle, die noch nicht steht. Alles dahinter wartet, bis sie steht.`;
    let reihenfolge = '';
    if (st >= 0) for (let k = st + 1; k < 6; k++) {
      if (state.ziel[k] > state.ist[k] && state.ziel[st] === state.ist[st]) { reihenfolge = `Hinweis: Du hast dir bei Baustelle ${k + 1} ein Ziel gesetzt, aber nicht bei Baustelle ${st + 1}. Erst vorne, dann hinten, sonst arbeitest du viel und änderst nichts.`; break; }
    }
    return `<div class="qz-screen">
      <div class="qz-ergebnis"><div class="qz-funken" id="qzFunken"></div>${stempel()}
        <p class="qz-eyebrow">Dein Ergebnis</p>
        <h2>Dein Bild</h2>
        <p class="sub">So sieht dein Betrieb heute aus, und wo du in sechs Monaten stehen willst.</p>
        <div class="qz-legende"><span><i style="background:var(--sand)"></i>Heute</span><span><i style="background:var(--gold);height:3px;vertical-align:3px"></i>Ziel</span></div>
        ${raster({ werte: true, start: st >= 0 ? st : undefined, verzoegert: true })}
        <figure class="qz-startbild"><img src="${st >= 0 ? bild(st) : root.dataset.haus}" alt=""></figure>
        <p class="qz-urteil">${urteil}</p>
        ${reihenfolge ? `<p class="qz-reihenfolge">${reihenfolge}</p>` : ''}
        <div class="qz-termin"><span class="ico-box"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2v4M16 2v4"/><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M3 10h18"/></svg></span><p><strong>Deine Verabredung mit dir selbst:</strong> Trag dir den <strong>${datumText}</strong> in den Kalender ein: „Selbstcheck wiederholen“. Dann siehst du, was sich bewegt hat und was nicht.</p></div>
        <div class="qz-aktionen">
          <a class="btn btn--gold" href="${root.dataset.anfrage}" data-track="selbstcheck_analysegespraech">Analysegespräch anfragen <span class="arr"></span></a>
          <button type="button" class="qz-klein" data-akt="ics">In den Kalender eintragen</button>
          <button type="button" class="qz-klein" data-akt="drucken">Als PDF sichern oder drucken</button>
          <button type="button" class="qz-klein" data-akt="neu">Neu starten</button>
        </div>
      </div>
      <p class="qz-fuss">Aus „Der Chef auf der Baustelle“ von Domenico Bentivegna, Teil 3. Deine Werte bleiben nur auf diesem Gerät gespeichert und werden nirgendwohin übertragen. <a href="${root.dataset.buch}">Zur Buchreihe</a></p>
    </div>`;
  }

  // Interaktion auf dem Regler: Zahl, Manometer-Nadel, Handrad und Stufentext laufen mit
  function reglerBinden(s: Schritt) {
    const r = document.getElementById('qzRange') as HTMLInputElement | null;
    if (!r) return;
    const i = s.i!, istZiel = s.typ === 'ziel';
    const zahl = document.getElementById('qzZahl')!;
    const nadel = document.getElementById('qzNadel');
    const bogenEl = document.getElementById('qzBogen');
    const setzeRegler = () => {
      const v = +r.value;
      r.style.setProperty('--p', ((v - 1) / 9) * 100 + '%');
      r.style.setProperty('--rot', (v - 1) * 36 + 'deg');
    };
    const setzeNadel = () => {
      if (nadel) nadel.style.transform = `rotate(${winkel(+r.value)}deg)`;
      if (bogenEl) { const h = state.ist[i], z = state.ziel[i]; bogenEl.setAttribute('d', z > h ? bogen(84, winkel(h), winkel(z)) : ''); }
    };
    const marke = document.getElementById('qzMarke');
    if (marke) { const p = ((state.ist[i] - 1) / 9) * 100; marke.style.left = `calc(${p}% + ${21 - (p / 100) * 42}px)`; }
    let alteStufe = anker(+r.value);
    const hinweis = () => {
      const h = document.getElementById('qzHinweis'); if (!h) return;
      const v = state.ist[i], t = state.ziel[i];
      h.className = 'qz-hinweis';
      if (t - v > 2) { h.textContent = 'Zwei Punkte in sechs Monaten sind viel. Jeder Punkt heißt: etwas anders machen, nicht anders finden.'; h.className = 'qz-hinweis warn'; }
      else if (t - v === 0) h.textContent = 'Kein Ziel heißt: diese Baustelle ist noch nicht dran. Das ist in Ordnung, wenn vorne noch etwas klemmt.';
      else h.textContent = `Von ${v} auf ${t} in sechs Monaten.`;
    };
    setzeRegler(); hinweis();
    // Nadel schwingt beim Öffnen von 0 auf den Wert
    requestAnimationFrame(() => requestAnimationFrame(setzeNadel));
    r.addEventListener('input', () => {
      let v = +r.value;
      if (istZiel && v < state.ist[i]) { v = state.ist[i]; r.value = String(v); }
      if (istZiel) state.ziel[i] = v;
      else { state.ist[i] = v; if (state.ziel[i] < v) state.ziel[i] = v; }
      zahl.textContent = String(v);
      if (!reduce) { zahl.classList.remove('hops'); void (zahl as unknown as HTMLElement).getBoundingClientRect(); zahl.classList.add('hops'); }
      setzeRegler(); setzeNadel();
      const a = document.getElementById('qzAnker');
      if (a) {
        const stufe = anker(v);
        a.innerHTML = `<b>${ankerLabel(v)}</b><p>${B[i].a[stufe]}</p>`;
        if (stufe !== alteStufe) { a.classList.remove('neu'); void a.offsetWidth; a.classList.add('neu'); alteStufe = stufe; }
      }
      hinweis();
      if (navigator.vibrate && !reduce) { try { navigator.vibrate(6); } catch (e) { /* leer */ } }
      speichern();
    });
    r.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); gehe(pos + 1); } });
  }

  function funken() {
    const box = document.getElementById('qzFunken'); if (!box || reduce) return;
    const farben = ['#ccc4af', '#998a6d', '#ffffff', '#e2dccd'];
    for (let n = 0; n < 36; n++) {
      const f = document.createElement('i');
      const blase = n % 3 === 0;
      const g = blase ? 6 + Math.random() * 9 : 7 + Math.random() * 10;
      if (blase) f.className = 'blase';
      f.style.cssText = `left:${Math.random() * 100}%;width:${g}px;height:${g}px;${blase ? '' : `background:${farben[n % farben.length]};`}--t:${2.6 + Math.random() * 1.8}s;--d:${0.3 + Math.random() * 1.3}s`;
      box.appendChild(f);
    }
  }

  function druckFassung() {
    const d = document.getElementById('qzDruck')!;
    const st = startIndex();
    d.innerHTML = `<h1>Selbstcheck „Sechs Baustellen“</h1><p>Der Chef auf der Baustelle · Stand ${new Date().toLocaleDateString('de-DE')} · Wiederholen am ${datumText}</p>
      <table><tr><th>Baustelle</th><th>Heute</th><th>Ziel</th><th>Bedeutung heute</th></tr>
      ${B.map((b, i) => `<tr><td>${i + 1}. ${b.t}${i === st ? ' (Start)' : ''}</td><td>${state.ist[i]}</td><td>${state.ziel[i]}</td><td>${b.a[anker(state.ist[i])]}</td></tr>`).join('')}</table>
      <p style="margin-top:10pt">${st < 0 ? 'Alle sechs Baustellen stehen bei 7 oder höher.' : `Hier fängst du an: Baustelle ${st + 1}, ${B[st].t.replace(/^\S+/, (w) => w.toLowerCase())}.`}</p>`;
  }

  function ics() {
    const d = wiederholung, p = (n: number) => String(n).padStart(2, '0');
    const tag = `${d.getFullYear()}${p(d.getMonth() + 1)}${p(d.getDate())}`;
    const f = new Date(d.getTime() + 86400000);
    const tag2 = `${f.getFullYear()}${p(f.getMonth() + 1)}${p(f.getDate())}`;
    const txt = ['BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//Bentivegna//Selbstcheck//DE', 'BEGIN:VEVENT', `UID:selbstcheck-${tag}@bentivegna`,
      `DTSTAMP:${new Date().toISOString().replace(/[-:]/g, '').slice(0, 15)}Z`, `DTSTART;VALUE=DATE:${tag}`, `DTEND;VALUE=DATE:${tag2}`,
      'SUMMARY:Selbstcheck wiederholen (Der Chef auf der Baustelle)', 'DESCRIPTION:Sechs Baustellen\\, eine Zahl von 1 bis 10: Was hat sich bewegt?', 'END:VEVENT', 'END:VCALENDAR'].join('\r\n');
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([txt], { type: 'text/calendar' }));
    a.download = 'selbstcheck-wiederholen.ics';
    document.body.appendChild(a); a.click(); a.remove();
    track('selbstcheck_kalender');
  }

  // Bilder der nächsten Schritte vorladen, damit nichts nachruckelt
  function vorladen() {
    [0, 1, 2, 3, 4, 5].map(bild).concat([root.dataset.lot || '']).forEach((src) => { if (src) { const im = new Image(); im.src = src; } });
  }

  let ladeTimer = 0;
  function zeichne() {
    const s = SCHRITTE[pos];
    clearTimeout(ladeTimer);
    app.classList.toggle('breit', s.typ === 'start');
    app.classList.toggle('mittel', s.typ === 'ist' || s.typ === 'ziel');
    if (s.typ === 'start') app.innerHTML = startScreen();
    else if (s.typ === 'ist' || s.typ === 'ziel') app.innerHTML = frageScreen(s);
    else if (s.typ === 'pause') app.innerHTML = pauseScreen(s);
    else if (s.typ === 'laden') app.innerHTML = ladenScreen();
    else app.innerHTML = ergebnisScreen();
    if (s.typ === 'ist' || s.typ === 'ziel') reglerBinden(s);
    // Wasser im Rohr fließt vom letzten Stand zum neuen
    const wasser = app.querySelector<HTMLElement>('.qz-rohr .wasser[data-ziel]');
    if (wasser) { const z = wasser.dataset.ziel!; letzterStand = +z; requestAnimationFrame(() => requestAnimationFrame(() => { wasser.style.width = z + '%'; })); }
    if (s.typ === 'laden') {
      const msgs = ['Baustellen werden sortiert', 'Reihenfolge wird geprüft', 'Dein Startpunkt wird ermittelt'];
      requestAnimationFrame(() => requestAnimationFrame(() => { const b = document.getElementById('qzBalken'); if (b) b.style.width = '100%'; }));
      let k = 0;
      const tick = () => { k++; const z = document.getElementById('qzZyklus'); if (z && k < msgs.length) { z.textContent = msgs[k]; ladeTimer = window.setTimeout(tick, 850); } else gehe(pos + 1, false); };
      ladeTimer = window.setTimeout(tick, reduce ? 300 : 850);
    }
    if (s.typ === 'ergebnis') {
      state.fertig = true; speichern(); druckFassung(); funken();
      track('selbstcheck_fertig', { start: startIndex() + 1 });
    }
    if (s.typ === 'start') letzterStand = 0;
    const top = root.getBoundingClientRect().top + window.scrollY;
    if (window.scrollY > top + 40) window.scrollTo({ top: Math.max(0, top - 10), behavior: reduce ? 'auto' : 'smooth' });
    const fokus = pos > 0 ? app.querySelector<HTMLElement>('h2, h1') : null;
    if (fokus) { fokus.setAttribute('tabindex', '-1'); fokus.focus({ preventScroll: true }); }
  }

  function gehe(ziel: number, mitAusblenden = true) {
    ziel = Math.max(0, Math.min(SCHRITTE.length - 1, ziel));
    const alt = app.querySelector('.qz-screen');
    if (alt && mitAusblenden && !reduce) { alt.classList.add('raus'); setTimeout(() => { pos = ziel; zeichne(); }, 220); }
    else { pos = ziel; zeichne(); }
  }

  app.addEventListener('click', (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>('[data-akt]'); if (!el) return;
    const akt = el.dataset.akt;
    if (akt === 'los') { track('selbstcheck_start'); vorladen(); gehe(1); }
    else if (akt === 'weiter') gehe(pos + 1);
    else if (akt === 'zurueck') { let z = pos - 1; while (z > 0 && SCHRITTE[z].typ === 'laden') z--; gehe(z); }
    else if (akt === 'ergebnis') gehe(SCHRITTE.length - 1);
    else if (akt === 'neu') { state = { ist: [5, 5, 5, 5, 5, 5], ziel: [5, 5, 5, 5, 5, 5] }; try { localStorage.removeItem(KEY); } catch (er) { /* leer */ } gehe(0); }
    else if (akt === 'drucken') window.print();
    else if (akt === 'ics') ics();
  });

  zeichne();
</script>
