  .qz-stempel{position:absolute!important;top:16px;right:16px;width:104px;color:var(--sand);opacity:.92;transform:rotate(-14deg);animation:qzStempel .5s cubic-bezier(.3,1.5,.5,1) 1.3s both;z-index:2;pointer-events:none}
  .qz-stempel svg{display:block;width:100%;height:auto}
  @keyframes qzStempel{0%{opacity:0;transform:scale(2.4) rotate(-3deg)}60%{opacity:1;transform:scale(.93) rotate(-15deg)}100%{opacity:.92;transform:scale(1) rotate(-14deg)}}
  .qz-startbild{display:flex;justify-content:center;margin:26px 0 0}
  .qz-startbild img{display:block;height:130px;width:auto;max-width:70%;filter:drop-shadow(0 14px 22px rgba(0,0,0,.35));animation:qzBloom .8s cubic-bezier(.3,1.4,.5,1) 1.4s both}
  .qz-urteil{font-family:var(--serif);font-size:1.28rem;line-height:1.45;text-align:center;margin:14px auto 6px;max-width:560px;animation:qzFade .6s ease 1.7s both}
  .qz-urteil strong{font-family:var(--sans);font-weight:800;color:var(--sand)}
  .qz-reihenfolge{text-align:center;font-size:.95rem;color:rgba(255,255,255,.78);max-width:540px;margin:8px auto 0}
  .qz-termin{display:flex;gap:14px;align-items:flex-start;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.14);border-radius:14px;padding:16px 18px;margin-top:22px;font-size:.98rem;color:rgba(255,255,255,.86)}
  .qz-termin strong{color:#fff}
  .qz-termin .ico-box{background:rgba(255,255,255,.1);color:var(--sand);width:40px;height:40px;flex:0 0 auto}
  .qz-aktionen{display:flex;flex-wrap:wrap;gap:10px;margin-top:22px;justify-content:center}
  .qz-klein{display:inline-flex;align-items:center;gap:8px;background:transparent;border:1px solid rgba(255,255,255,.4);color:#fff;font:inherit;font-weight:700;font-size:.92rem;padding:11px 16px;border-radius:10px;cursor:pointer}
  .qz-klein:hover{background:rgba(255,255,255,.1)}
  .qz-fuss{text-align:center;font-size:.86rem;color:var(--muted);margin-top:18px}
