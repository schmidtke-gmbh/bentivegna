  @keyframes qzWumms{50%{transform:translateY(3px)}}
  .qz-ergebnis::before{content:"";position:absolute;inset:0;pointer-events:none;background-image:linear-gradient(rgba(255,255,255,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.04) 1px,transparent 1px);background-size:24px 24px}
  .qz-ergebnis>*{position:relative}
  .qz-ergebnis .qz-eyebrow{color:var(--sand);text-align:center}
