  .qz-funken i.blase{clip-path:none;background:radial-gradient(circle at 35% 35%,rgba(255,255,255,.55),rgba(255,255,255,.05) 60%);border:1.5px solid rgba(255,255,255,.6);border-radius:50%;animation-name:qzBlase}
  @keyframes qzFunke{0%{opacity:0;transform:translateY(0) rotate(0) scale(.4)}15%{opacity:1;transform:translateY(-30px) rotate(45deg) scale(1)}100%{opacity:0;transform:translateY(-420px) rotate(260deg) scale(.6)}}
  @keyframes qzBlase{0%{opacity:0;transform:translate(0,0)}15%{opacity:.9}35%{transform:translate(9px,-150px)}65%{transform:translate(-8px,-290px)}100%{opacity:0;transform:translate(6px,-430px)}}
